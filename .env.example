# =============================================================================
# KOBIA.AI — Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git (already in .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Neon Postgres) — REQUIRED
# -----------------------------------------------------------------------------
# Get from https://neon.tech → your project → connection details
# For local dev with SQLite (Cycle 1 only), use: file:./dev.db
DATABASE_URL="postgresql://user:password@host.neon.tech/kobia?sslmode=require"

# -----------------------------------------------------------------------------
# Authentication (Clerk) — REQUIRED
# -----------------------------------------------------------------------------
# Get from https://clerk.com → your app → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# -----------------------------------------------------------------------------
# App Config — REQUIRED
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="kobia.ai"  # or kobia.app / getkobia.com depending on Lock decision
NODE_ENV="development"

# -----------------------------------------------------------------------------
# Email (Resend) — OPTIONAL until Cycle 2
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@kobia.ai"

# -----------------------------------------------------------------------------
# Monitoring (Sentry + PostHog) — OPTIONAL until Cycle 3
# -----------------------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# -----------------------------------------------------------------------------
# AI (OpenAI / Anthropic) — OPTIONAL until Cycle 5
# -----------------------------------------------------------------------------
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
