// =============================================================================
// KOBIA Platform schema (public) - schema-per-tenant model, Sprint 1.
// =============================================================================
// Holds platform-level tables that live in `public` and span all tenants:
// the tenant registry. Users / memberships / billing remain on the legacy
// row-level client for now (Decision 1a: do not rewrite the 2,286-line
// schema this sprint; hidden accounting stays on src/lib/db.ts).
//
// Generated to a dedicated client output so it does NOT collide with the
// default @prisma/client used by legacy accounting code.
//
// No em-dashes in comments by project convention (use hyphens).
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../src/lib/db/generated/platform"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Registry of all tenants. One row per tenant; the source of truth that maps a
/// slug to its dedicated Postgres schema (tenant_<slug>).
model TenantRegistry {
  id         String   @id @default(cuid())
  slug       String   @unique
  schemaName String   @unique @map("schema_name")
  status     String   @default("ACTIVE") // ACTIVE | SUSPENDED | PROVISIONING
  plan       String   @default("FREE")
  // Nullable: Clerk Organizations are not wired in Sprint 1 (slug-in-URL
  // resolution). Stored now so adopting Clerk Orgs later is a drop-in.
  clerkOrgId String?  @map("clerk_org_id")
  // Sprint 5: Stripe billing scaffolding. All nullable; populated by the
  // billing webhook / checkout flow. Stays additive so a tenant with no
  // subscription still resolves.
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  subscriptionStatus   String?   @map("subscription_status")
  subscriptionRenewsAt DateTime? @map("subscription_renews_at")
  trialEndsAt          DateTime? @map("trial_ends_at")
  seatsPurchased       Int       @default(1) @map("seats_purchased")
  seatsUsed            Int       @default(0) @map("seats_used")
  billingEmail         String?   @map("billing_email")
  // Sprint 5: per-tenant theme. Defaults injected in app code when null.
  theme      Json?
  // Sprint 5: human-friendly workspace name (the slug is the URL-safe id).
  displayName String?  @map("display_name")
  // Sprint 5: workspace defaults editable from /app/settings/workspace.
  timezone    String?  @map("timezone")
  logoUrl     String?  @map("logo_url")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("tenant_registry")
}

/// Append-only log of Stripe webhook events, for audit / debugging.
model BillingEvent {
  id        String   @id @default(cuid())
  tenantId  String?  @map("tenant_id")
  type      String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@map("billing_event")
}
