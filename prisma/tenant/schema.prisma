// =============================================================================
// KOBIA Tenant schema - schema-per-tenant business tables, Sprint 1.
// =============================================================================
// These tables are replicated into each tenant_<slug> Postgres schema. The
// schema itself provides isolation, so there is NO tenantId column and NO FK
// back to a shared Tenant table (contrast with the legacy row-level schema in
// prisma/schema.prisma, which stays in use for hidden accounting code).
//
// At runtime the client is bound to a specific schema via ?schema=tenant_<slug>
// (see src/lib/db/tenant-prisma.ts). Migrations are applied per schema by
// scripts/provision-tenant.ts.
//
// Sprint 1 seeds the v0.1 CRM core so provisioning has a real migration to
// deploy. Fuller CRM behavior (custom fields, tags, sharing, automation
// actions) arrives in later sprints.
//
// Generated to a dedicated client output so it does NOT collide with the
// default @prisma/client used by legacy accounting code.
//
// No em-dashes in comments by project convention (use hyphens).
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../src/lib/db/generated/tenant"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadSource {
  WEBSITE
  REFERRAL
  CALL
  EMAIL
  EVENT
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum DealStatus {
  OPEN
  WON
  LOST
}

// Sprint 10: multi-pipeline + products/quotes enums.
enum PipelineEntityType {
  DEAL
  LEAD
  TICKET
}

enum StageWonOrLost {
  OPEN
  WON
  LOST
}

enum ProductType {
  ONE_TIME
  RECURRING_MONTHLY
  RECURRING_YEARLY
  SERVICE
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
}

// Sprint 3: shared engines (custom fields, tags, audit) and the entity type
// they hang off of. CompanySize is a fixed bucket set for the Companies module.

enum CrmEntityType {
  LEAD
  DEAL
  CONTACT
  COMPANY
}

// Sprint 9: global search index + saved views. SearchEntityType is broader than
// CrmEntityType because the index also covers activities, files, emails, notes.

enum SearchEntityType {
  LEAD
  DEAL
  CONTACT
  COMPANY
  ACTIVITY
  FILE
  EMAIL_MESSAGE
  NOTE
  TASK
  PROJECT
  TASK_COMMENT
  EVENT
  BOOKING_PAGE
  LANDING_PAGE
  BROADCAST
  DOCUMENT
  DOC_FOLDER
  TICKET
  KB_ARTICLE
  CHAT_MESSAGE
}

enum SavedViewEntityType {
  LEAD
  DEAL
  CONTACT
  COMPANY
  ACTIVITY
  FILE
}

enum SavedViewScope {
  PERSONAL
  TENANT
}

enum SavedViewSortDir {
  ASC
  DESC
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
  URL
  EMAIL
  PHONE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
}

enum CompanySize {
  SIZE_1_10
  SIZE_11_50
  SIZE_51_200
  SIZE_201_1000
  SIZE_1000_PLUS
}

model Company {
  id        String       @id @default(cuid())
  name      String
  domain    String?
  industry  String?
  size      CompanySize?
  website   String?
  phone     String?
  address   String?
  ownerUserId String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  contacts   Contact[]
  deals      Deal[]
  activities CrmActivity[]

  @@index([name])
}

model Contact {
  id         String   @id @default(cuid())
  salutation String?
  firstName  String
  lastName   String?
  email      String?
  phone      String?
  title      String?
  companyId  String?
  ownerUserId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company    Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  deals      Deal[]
  activities CrmActivity[]
  tickets    Ticket[]
  portalSessions CustomerPortalSession[]

  @@index([companyId])
  @@index([lastName])
}

model Lead {
  id          String     @id @default(cuid())
  name        String
  companyName String?
  email       String?
  phone       String?
  source      LeadSource @default(WEBSITE)
  status      LeadStatus @default(NEW)
  ownerUserId String?
  notes       String?
  convertedAt DateTime?
  // Sprint 10: optional pipeline + stage so Leads can run a kanban.
  pipelineId  String?
  stageId     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  activities CrmActivity[]

  @@index([status])
  @@index([ownerUserId])
  @@index([pipelineId, stageId])
}

model Pipeline {
  id         String             @id @default(cuid())
  name       String             @unique
  isDefault  Boolean            @default(false)
  // Sprint 10: which record type this pipeline drives (DEAL or LEAD; TICKET reserved).
  entityType PipelineEntityType @default(DEAL)
  archivedAt DateTime?
  color      String?
  order      Int                @default(0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  stages DealStage[]
  deals  Deal[]
}

model DealStage {
  id           String         @id @default(cuid())
  pipelineId   String
  name         String
  sortOrder    Int            @default(0)
  // Sprint 10: probability/rotting/wonOrLost supersede the isWon/isLost bools,
  // which are retained for backwards compatibility and populated in parallel.
  probability  Int            @default(0)
  rotting_days Int?
  wonOrLost    StageWonOrLost @default(OPEN)
  color        String?
  isWon        Boolean        @default(false)
  isLost       Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId, sortOrder])
}

model Deal {
  id             String     @id @default(cuid())
  pipelineId     String
  stageId        String
  name           String
  companyId      String?
  contactId      String?
  ownerUserId    String?
  amountCents    BigInt     @default(0)
  probabilityPct Int        @default(50)
  closeDate      DateTime?
  status         DealStatus @default(OPEN)
  wonAt          DateTime?
  lostAt         DateTime?
  lostReason     String?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  pipeline   Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage      DealStage      @relation(fields: [stageId], references: [id], onDelete: Restrict)
  company    Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact    Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  activities CrmActivity[]
  lineItems  DealLineItem[]
  quotes     Quote[]

  @@index([status])
  @@index([pipelineId, stageId])
  @@index([ownerUserId])
}

model CrmActivity {
  id                 String       @id @default(cuid())
  type               ActivityType @default(NOTE)
  subject            String
  body               String?
  occurredAt         DateTime     @default(now())
  createdByUserId    String?
  // Sprint 4: task-style activities gained a due date, completion stamp, and an
  // explicit owner so the Activities module can show open/done/overdue states.
  dueAt              DateTime?
  completedAt        DateTime?
  ownerClerkUserId   String?
  leadId             String?
  dealId             String?
  contactId          String?
  companyId          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([occurredAt])
  @@index([dueAt])
  @@index([ownerClerkUserId])
  @@index([leadId])
  @@index([dealId])
  @@index([contactId])
  @@index([companyId])
}

// =============================================================================
// Sprint 3 engines: custom fields, tags, audit log.
// These are tenant-scoped (they live in tenant_<slug>) because the field
// definitions, tags, and audit trail are per-tenant. entityId is a soft
// reference (no DB FK) so one row type can point at any CRM entity.
// =============================================================================

model CustomField {
  id         String          @id @default(cuid())
  entityType CrmEntityType
  key        String
  label      String
  type       CustomFieldType @default(TEXT)
  options    Json?
  required   Boolean         @default(false)
  order      Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  values CustomFieldValue[]

  @@unique([entityType, key])
  @@index([entityType, order])
}

model CustomFieldValue {
  id            String        @id @default(cuid())
  customFieldId String
  entityType    CrmEntityType
  entityId      String
  value         Json
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([customFieldId, entityId])
  @@index([entityType, entityId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#1d77bd")
  createdAt DateTime @default(now())

  assignments TagAssignment[]
}

model TagAssignment {
  id         String        @id @default(cuid())
  tagId      String
  entityType CrmEntityType
  entityId   String
  createdAt  DateTime      @default(now())

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, entityType, entityId])
  @@index([entityType, entityId])
}

model AuditEntry {
  id                String      @id @default(cuid())
  actorClerkUserId  String?
  actorEmail        String?
  action            AuditAction
  entityType        CrmEntityType
  entityId          String
  diff              Json?
  ip                String?
  userAgent         String?
  createdAt         DateTime    @default(now())

  @@index([entityType, createdAt])
  @@index([action])
  @@index([createdAt])
}

// =============================================================================
// Sprint 4: Activities are covered by the extended CrmActivity above. The
// Automations engine and Reports module add the models below. AutomationEntity
// is a superset of CrmEntityType (it adds ACTIVITY) so an automation can be
// keyed to activity events; the four-value CrmEntityType stays as-is because
// tags / custom fields / audit only ever target the four core records.
// =============================================================================

enum AutomationEntity {
  LEAD
  DEAL
  CONTACT
  COMPANY
  ACTIVITY
  TASK
  PROJECT
  EVENT
  BOOKING
}

enum AutomationTrigger {
  RECORD_CREATED
  RECORD_UPDATED
  FIELD_CHANGED
  STAGE_CHANGED
  ACTIVITY_DUE
  SCHEDULE
  EMAIL_SENT
  EMAIL_RECEIVED
  SMS_RECEIVED
  CALL_COMPLETED
  FILE_UPLOADED
  STAGE_TIME_EXCEEDED
  DEAL_AMOUNT_CHANGED
  QUOTE_SENT
  QUOTE_ACCEPTED
  LINE_ITEM_ADDED
  TASK_CREATED
  TASK_STATUS_CHANGED
  TASK_DUE_SOON
  TASK_OVERDUE
  PROJECT_STATUS_CHANGED
  EVENT_CREATED
  EVENT_STARTING_SOON
  BOOKING_CONFIRMED
}

enum FileStorageProvider {
  S3
  LOCAL
}

enum FileStatus {
  UPLOADING
  READY
  FAILED
  DELETED
}

enum FileSource {
  MANUAL
  EMAIL
  SMS
  AUTOMATION
  WEBFORM
}

enum FileAttachmentEntity {
  LEAD
  DEAL
  CONTACT
  COMPANY
  ACTIVITY
  EMAIL_MESSAGE
  SMS_MESSAGE
  NOTE
}

enum AutomationRunStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum AutomationQueueStatus {
  PENDING
  DONE
  FAILED
}

model Automation {
  id                   String            @id @default(cuid())
  name                 String
  description          String?
  enabled              Boolean           @default(true)
  triggerType          AutomationTrigger
  triggerConfig        Json?
  entityType           AutomationEntity
  conditions           Json?
  actions              Json
  createdByClerkUserId String?
  deletedAt            DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  runs AutomationRun[]

  @@index([entityType, triggerType, enabled])
  @@index([deletedAt])
}

model AutomationRun {
  id              String              @id @default(cuid())
  automationId    String
  entityType      AutomationEntity
  entityId        String?
  status          AutomationRunStatus
  startedAt       DateTime            @default(now())
  finishedAt      DateTime?
  error           String?
  actionsExecuted Json?

  automation Automation        @relation(fields: [automationId], references: [id], onDelete: Cascade)
  queueItems AutomationQueue[]

  @@index([automationId, startedAt])
  @@index([status])
}

model AutomationQueue {
  id              String                @id @default(cuid())
  automationRunId String
  resumeAt        DateTime
  payload         Json?
  status          AutomationQueueStatus @default(PENDING)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  automationRun AutomationRun @relation(fields: [automationRunId], references: [id], onDelete: Cascade)

  @@index([status, resumeAt])
}

model SavedReport {
  id               String   @id @default(cuid())
  name             String
  definition       Json
  ownerClerkUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([createdAt])
}

// =============================================================================
// Sprint 5: RBAC (Membership), in-app Notifications, and Web-to-Lead forms.
// All tenant-scoped (they live in tenant_<slug>). Membership is keyed by the
// Clerk user id and is distinct from the legacy row-level Membership used by
// the hidden accounting code (prisma/schema.prisma). The four-value
// CrmEntityType stays untouched.
// =============================================================================

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model Membership {
  id          String           @id @default(cuid())
  clerkUserId String           @unique
  role        MembershipRole   @default(MEMBER)
  email       String?
  displayName String?
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([role])
  @@index([status])
}

enum NotificationType {
  MENTION
  ASSIGNMENT
  DUE_SOON
  AUTOMATION_RESULT
  SYSTEM
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_MENTIONED
  TASK_COMMENTED
  EVENT_INVITE
  EVENT_REMINDER
  BOOKING_CREATED
}

model Notification {
  id          String           @id @default(cuid())
  clerkUserId String
  type        NotificationType @default(SYSTEM)
  title       String
  body        String?
  linkUrl     String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([clerkUserId, readAt])
  @@index([createdAt])
}

model NotificationPref {
  id          String           @id @default(cuid())
  clerkUserId String
  type        NotificationType
  inApp       Boolean          @default(true)
  email       Boolean          @default(false)
  updatedAt   DateTime         @updatedAt

  @@unique([clerkUserId, type])
}

model WebForm {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  fieldsConfig Json
  thankYouUrl  String?
  redirectUrl  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
}

// =============================================================================
// Sprint 6: Email integration. Per-user mail accounts (SMTP/IMAP + OAuth
// stubs), threads/messages auto-linked to CRM records, templates, signatures.
// Secrets are stored encrypted (see src/lib/crypto/secrets.ts); when the
// encryption key is unset they fall back to plaintext with a UI warning.
// =============================================================================

enum EmailProvider {
  SMTP_IMAP
  GMAIL_OAUTH
  OUTLOOK_OAUTH
}

enum EmailAccountStatus {
  ACTIVE
  PAUSED
  ERROR
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum EmailMessageStatus {
  DRAFT
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

enum EmailRecordType {
  LEAD
  DEAL
  CONTACT
  COMPANY
}

enum EmailTemplateScope {
  PERSONAL
  TENANT
}

model EmailAccount {
  id                         String             @id @default(cuid())
  ownerClerkUserId           String
  address                    String
  provider                   EmailProvider      @default(SMTP_IMAP)
  displayName                String?
  smtpHost                   String?
  smtpPort                   Int?
  smtpUser                   String?
  smtpPassEncrypted          String?
  imapHost                   String?
  imapPort                   Int?
  imapUser                   String?
  imapPassEncrypted          String?
  oauthRefreshTokenEncrypted String?
  status                     EmailAccountStatus @default(ACTIVE)
  lastSyncedAt               DateTime?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  threads  EmailThread[]
  messages EmailMessage[]

  @@unique([ownerClerkUserId, address])
  @@index([status])
}

model EmailThread {
  id               String           @id @default(cuid())
  subject          String?
  lastMessageAt    DateTime?
  participantsJson Json?
  recordType       EmailRecordType?
  recordId         String?
  accountId        String
  messageCount     Int              @default(0)
  unreadCount      Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  account  EmailAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages EmailMessage[]

  @@index([recordType, recordId])
  @@index([accountId, lastMessageAt])
}

model EmailMessage {
  id           String             @id @default(cuid())
  threadId     String
  accountId    String
  externalId   String?
  direction    EmailDirection
  fromAddress  String
  toAddresses  Json
  ccAddresses  Json?
  bccAddresses Json?
  subject      String?
  bodyHtml     String?
  bodyText     String?
  snippet      String?
  sentAt       DateTime?
  receivedAt   DateTime?
  readAt       DateTime?
  status       EmailMessageStatus @default(SENT)
  errorMessage String?
  repliedTo    String?
  createdAt    DateTime           @default(now())

  thread      EmailThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  account     EmailAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  attachments EmailAttachment[]

  @@index([threadId])
  @@index([externalId])
  @@index([status])
}

model EmailAttachment {
  id         String   @id @default(cuid())
  messageId  String
  fileId     String?
  filename   String
  mimeType   String
  size       Int
  storageKey String
  createdAt  DateTime @default(now())

  message EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([fileId])
}

model EmailTemplate {
  id               String             @id @default(cuid())
  name             String
  subject          String
  bodyHtml         String
  variables        Json?
  scope            EmailTemplateScope @default(PERSONAL)
  ownerClerkUserId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([scope])
}

model EmailSignature {
  id               String   @id @default(cuid())
  ownerClerkUserId String
  html             String
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerClerkUserId])
}

// Sprint 7: Calling + SMS via Twilio.

enum PhoneNumberType {
  LOCAL
  TOLL_FREE
  MOBILE
}

enum PhoneNumberProvider {
  TWILIO
  MANUAL
}

enum PhoneNumberStatus {
  ACTIVE
  RELEASED
  PORTING
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  BUSY
  NO_ANSWER
  FAILED
  CANCELED
}

enum SmsDirection {
  INBOUND
  OUTBOUND
}

enum SmsMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum TelephonyRuleKind {
  VOICE
  SMS
}

model PhoneNumber {
  id                String              @id @default(cuid())
  e164              String              @unique
  friendlyName      String?
  type              PhoneNumberType     @default(LOCAL)
  provider          PhoneNumberProvider @default(TWILIO)
  providerSid       String?
  capabilities      Json?
  assignedClerkUserId String?
  status            PhoneNumberStatus   @default(ACTIVE)
  purchasedAt       DateTime?
  monthlyPriceCents Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  rules TelephonyRule[]

  @@index([status])
  @@index([assignedClerkUserId])
}

model Call {
  id                   String        @id @default(cuid())
  direction            CallDirection
  fromE164             String
  toE164               String
  providerCallSid      String?
  status               CallStatus    @default(QUEUED)
  startedAt            DateTime?
  answeredAt           DateTime?
  endedAt              DateTime?
  durationSec          Int           @default(0)
  recordingUrl         String?
  recordingDurationSec Int?
  transcript           String?
  voicemailUrl         String?
  ownerClerkUserId     String?
  contactId            String?
  dealId               String?
  leadId               String?
  companyId            String?
  notes                String?
  createdAt            DateTime      @default(now())

  @@index([contactId])
  @@index([leadId])
  @@index([dealId])
  @@index([companyId])
  @@index([ownerClerkUserId, startedAt(sort: Desc)])
  @@index([providerCallSid])
}

model SmsThread {
  id            String       @id @default(cuid())
  contactId     String?
  leadId        String?
  ourNumberE164 String
  peerE164      String
  lastMessageAt DateTime?
  messageCount  Int          @default(0)
  unreadCount   Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  messages SmsMessage[]

  @@unique([ourNumberE164, peerE164])
  @@index([contactId])
  @@index([leadId])
}

model SmsMessage {
  id                String           @id @default(cuid())
  threadId          String
  direction         SmsDirection
  fromE164          String
  toE164            String
  body              String
  mediaUrls         Json?
  providerMessageSid String?
  status            SmsMessageStatus @default(QUEUED)
  errorCode         String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime         @default(now())

  thread SmsThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([providerMessageSid])
}

model TelephonyRule {
  id            String            @id @default(cuid())
  phoneNumberId String
  kind          TelephonyRuleKind
  config        Json
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  phoneNumber PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)

  @@index([phoneNumberId])
}

model UserPreference {
  id                   String   @id @default(cuid())
  clerkUserId          String   @unique
  callForwardingE164   String?
  receiveCallNotifications Boolean @default(true)
  defaultOutboundNumberId String?
  defaultEmailAccountId String?
  defaultSignatureId   String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// =============================================================================
// Sprint 8: Files + Document Library. Additive only - new enums + new tables.
// =============================================================================

model FileFolder {
  id               String       @id @default(cuid())
  name             String
  parentId         String?
  ownerClerkUserId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  parent   FileFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children FileFolder[] @relation("FolderTree")
  files    File[]

  @@index([parentId])
}

model File {
  id                   String              @id @default(cuid())
  name                 String
  mimeType             String
  size                 BigInt              @default(0)
  storageProvider      FileStorageProvider @default(S3)
  storageKey           String              @unique
  storageBucket        String?
  sha256               String?
  uploadedByClerkUserId String?
  status               FileStatus          @default(UPLOADING)
  previewKey           String?
  width                Int?
  height               Int?
  durationSec          Int?
  folderId             String?
  source               FileSource          @default(MANUAL)
  externalUrl          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  folder      FileFolder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  attachments FileAttachment[]
  shareLinks  FileShareLink[]

  @@index([folderId])
  @@index([uploadedByClerkUserId])
  @@index([createdAt(sort: Desc)])
}

model FileAttachment {
  id                   String               @id @default(cuid())
  fileId               String
  entityType           FileAttachmentEntity
  entityId             String
  attachedByClerkUserId String?
  createdAt            DateTime             @default(now())

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, entityType, entityId])
  @@index([entityType, entityId])
}

model FileShareLink {
  id                  String    @id @default(cuid())
  fileId              String
  slug                String    @unique
  password            String?
  expiresAt           DateTime?
  maxDownloads        Int?
  downloadCount       Int       @default(0)
  createdByClerkUserId String?
  createdAt           DateTime  @default(now())

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
}

// Sprint 9: global full-text search index. One row per indexable entity. The
// `tsv` column is a GENERATED tsvector (built in SQL by migration 0009_search)
// over title/subtitle/body; it is queried with websearch_to_tsquery + ts_rank_cd.
// Prisma cannot express the generated expression, so `tsv` is Unsupported and is
// never written from app code - only read implicitly via raw queries.

model SearchIndex {
  id               String           @id @default(cuid())
  entityType       SearchEntityType
  entityId         String
  title            String
  subtitle         String?
  body             String?
  tsv              Unsupported("tsvector")?
  ownerClerkUserId String?
  updatedAt        DateTime         @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
}

// Sprint 9: saved views / filters for list pages. `filters`, `columns` are JSON
// blobs interpreted per entity by the list UI. PERSONAL scope is owner-only;
// TENANT scope is shared. For Deals kanban, filters may also carry pipelineId.

model SavedView {
  id               String              @id @default(cuid())
  entityType       SavedViewEntityType
  name             String
  ownerClerkUserId String?
  scope            SavedViewScope      @default(PERSONAL)
  filters          Json
  sortBy           String?
  sortDir          SavedViewSortDir    @default(DESC)
  columns          Json
  groupBy          String?
  isDefault        Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([entityType, ownerClerkUserId])
}

