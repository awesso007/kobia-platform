enum EnvelopeAuditEventType {
  CREATED
  SENT
  VIEWED
  SIGNED
  DECLINED
  VOIDED
  COMPLETED
}

model DocFolder {
  id          String   @id @default(cuid())
  name        String
  parentId    String?
  path        String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      DocFolder?  @relation("DocFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    DocFolder[] @relation("DocFolderTree")
  documents   Document[]
  permissions DocumentPermission[]

  @@index([parentId])
  @@index([path])
}

model Document {
  id          String       @id @default(cuid())
  name        String
  folderId    String?
  kind        DocumentKind @default(FILE)
  mimeType    String?
  sizeBytes   Int          @default(0)
  storageKey  String?
  bodyHtml    String?
  version     Int          @default(1)
  isLocked    Boolean      @default(false)
  lockedById  String?
  createdById String?
  updatedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  folder      DocFolder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions    DocumentVersion[]
  shareLinks  DocumentShareLink[]
  permissions DocumentPermission[]
  envelopes   Envelope[]

  @@index([folderId])
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  version     Int
  name        String
  mimeType    String?
  sizeBytes   Int      @default(0)
  storageKey  String?
  bodyHtml    String?
  createdById String?
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentShareLink {
  id            String    @id @default(cuid())
  documentId    String
  token         String    @unique
  password      String?
  expiresAt     DateTime?
  allowDownload Boolean   @default(true)
  createdById   String?
  createdAt     DateTime  @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([token])
}

model DocumentPermission {
  id         String                  @id @default(cuid())
  documentId String?
  folderId   String?
  userId     String?
  role       String?
  permission DocumentPermissionLevel @default(VIEW)
  createdAt  DateTime                @default(now())

  document Document?  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  folder   DocFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([folderId])
}

model Envelope {
  id          String         @id @default(cuid())
  name        String
  status      EnvelopeStatus @default(DRAFT)
  documentId  String
  message     String?
  createdById String?
  sentAt      DateTime?
  completedAt DateTime?
  voidedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  document    Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signers     EnvelopeSigner[]
  auditEvents EnvelopeAuditEvent[]

  @@index([documentId])
  @@index([status])
}

model EnvelopeSigner {
  id          String               @id @default(cuid())
  envelopeId  String
  name        String
  email       String
  order       Int                  @default(0)
  status      EnvelopeSignerStatus @default(PENDING)
  signedAt    DateTime?
  declinedAt  DateTime?
  token       String               @unique
  fields      Json
  signatureData String?
  reminderSentAt DateTime?

  envelope    Envelope             @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  auditEvents EnvelopeAuditEvent[]

  @@index([envelopeId])
  @@index([token])
}

model EnvelopeAuditEvent {
  id         String                 @id @default(cuid())
  envelopeId String
  signerId   String?
  event      EnvelopeAuditEventType
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime               @default(now())

  envelope Envelope        @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  signer   EnvelopeSigner? @relation(fields: [signerId], references: [id], onDelete: SetNull)

  @@index([envelopeId])
}

// ----------------------------------------------------------------------------
// Sprint 15: Helpdesk (ticketing + SLA + knowledge base + customer portal).
// ----------------------------------------------------------------------------

enum TicketStatus {
  NEW
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketChannel {
  EMAIL
  PORTAL
  PHONE
  CHAT
  MANUAL
}

enum TicketAuthorType {
  AGENT
  CUSTOMER
  SYSTEM
}

enum TicketAuditEventType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  REPLIED
  INTERNAL_NOTE
  MERGED
  CLOSED
  REOPENED
  SLA_BREACHED
}

enum KbStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum KbVisibility {
  PUBLIC
  INTERNAL
  AUTHENTICATED
}

model Ticket {
  id                 String         @id @default(cuid())
  number             Int            @unique
  subject            String
  description        String
  status             TicketStatus   @default(NEW)
  priority           TicketPriority @default(NORMAL)
  channel            TicketChannel  @default(MANUAL)
  requesterContactId String?
  requesterEmail     String
  requesterName      String
  assigneeId         String?
  teamId             String?
  categoryId         String?
  slaPolicyId        String?
  firstResponseDueAt DateTime?
  resolveDueAt       DateTime?
  firstResponseAt    DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  tags               String[]       @default([])
  customFieldsJson   Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  requesterContact Contact?         @relation(fields: [requesterContactId], references: [id], onDelete: SetNull)
  team             Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  category         TicketCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  slaPolicy        SlaPolicy?       @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  messages         TicketMessage[]
  attachments      TicketAttachment[]
  watchers         TicketWatcher[]
  auditEvents      TicketAuditEvent[]

  @@index([status, priority])
  @@index([assigneeId])
  @@index([teamId])
  @@index([requesterEmail])
  @@index([number])
  @@index([categoryId])
}

model TicketMessage {
  id          String           @id @default(cuid())
  ticketId    String
  authorType  TicketAuthorType
  authorId    String?
  authorName  String
  authorEmail String?
  bodyHtml    String
  isInternal  Boolean          @default(false)
  attachments Json?
  createdAt   DateTime         @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model TicketAttachment {
  id          String   @id @default(cuid())
  ticketId    String
  messageId   String?
  name        String
  mimeType    String
  sizeBytes   Int      @default(0)
  storageKey  String
  createdById String?
  createdAt   DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Team {
  id            String   @id @default(cuid())
  name          String
  description   String?
  memberIdsJson Json
  createdAt     DateTime @default(now())

  tickets Ticket[]

  @@index([name])
}

model TicketCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  slaPolicyId String?
  color       String?
  createdAt   DateTime @default(now())

  tickets Ticket[]

  @@index([name])
}

model SlaPolicy {
  id                   String   @id @default(cuid())
  name                 String
  description          String?
  firstResponseMinutes Int      @default(60)
  resolveMinutes       Int      @default(1440)
  businessHoursOnly    Boolean  @default(false)
  priorityOverrides    Json?
  createdAt            DateTime @default(now())

  tickets Ticket[]

  @@index([name])
}

model TicketWatcher {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@index([ticketId])
}

model KbArticle {
  id              String       @id @default(cuid())
  slug            String       @unique
  title           String
  bodyHtml        String
  summary         String?
  categoryId      String?
  status          KbStatus     @default(DRAFT)
  visibility      KbVisibility @default(PUBLIC)
  authorId        String?
  viewCount       Int          @default(0)
  helpfulCount    Int          @default(0)
  notHelpfulCount Int          @default(0)
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  category KbCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  feedback KbFeedback[]

  @@index([slug])
  @@index([categoryId])
  @@index([status])
}

model KbCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  order       Int      @default(0)
  parentId    String?
  createdAt   DateTime @default(now())

  articles KbArticle[]

  @@index([slug])
}

model KbFeedback {
  id        String   @id @default(cuid())
  articleId String
  helpful   Boolean
  comment   String?
  createdAt DateTime @default(now())

  article KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model CustomerPortalSession {
  id         String    @id @default(cuid())
  contactId  String
  email      String
  token      String    @unique
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([contactId])
}

model TicketAuditEvent {
  id           String               @id @default(cuid())
  ticketId     String
  actorType    TicketAuthorType
  actorId      String?
  event        TicketAuditEventType
  oldValue     String?
  newValue     String?
  metadataJson Json?
  createdAt    DateTime             @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Sprint 16: Chat / internal messaging. Channels (public/private/DM), messages
// with threads + mentions + reactions, presence, pins, and per-channel
// notification prefs. Authored by Membership.clerkUserId (stored as authorId).
// ---------------------------------------------------------------------------

enum ChatChannelKind {
  PUBLIC
  PRIVATE
  DM
  GROUP_DM
}

enum ChatMemberRole {
  ADMIN
  MEMBER
}

enum ChatPresenceStatus {
  ONLINE
  AWAY
  DND
  OFFLINE
}

enum ChatNotificationLevel {
  ALL
  MENTIONS
  NONE
}

model ChatChannel {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String?
  kind        ChatChannelKind @default(PUBLIC)
  isArchived  Boolean         @default(false)
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  members        ChatMember[]
  messages       ChatMessage[]
  pinnedMessages ChatPinnedMessage[]
  notifPrefs     ChatNotificationPref[]

  @@index([kind])
  @@index([isArchived])
}

model ChatMember {
  id         String         @id @default(cuid())
  channelId  String
  userId     String
  role       ChatMemberRole @default(MEMBER)
  joinedAt   DateTime       @default(now())
  lastReadAt DateTime?
  mutedUntil DateTime?

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
}

model ChatMessage {
  id          String    @id @default(cuid())
  channelId   String
  parentId    String?
  authorId    String
  authorName  String
  bodyText    String
  bodyHtml    String?
  attachments Json?
  mentionsJson Json?
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  channel        ChatChannel         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  parent         ChatMessage?        @relation("ChatThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies        ChatMessage[]       @relation("ChatThread")
  reactions      ChatReaction[]
  pinnedMessages ChatPinnedMessage[]

  @@index([channelId])
  @@index([parentId])
  @@index([authorId])
  @@index([createdAt])
}

model ChatReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model ChatPresence {
  id           String             @id @default(cuid())
  userId       String             @unique
  status       ChatPresenceStatus @default(OFFLINE)
  customStatus String?
  lastSeenAt   DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model ChatPinnedMessage {
  id         String   @id @default(cuid())
  channelId  String
  messageId  String
  pinnedById String?
  createdAt  DateTime @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([channelId, messageId])
  @@index([channelId])
}

model ChatNotificationPref {
  id        String                @id @default(cuid())
  userId    String
  channelId String
  level     ChatNotificationLevel @default(ALL)
  updatedAt DateTime              @updatedAt

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([channelId])
}

// Sprint 17: Sites / Landing Page Builder - multi-page marketing sites with
// reusable blocks, themes, custom domains, and lightweight analytics.

enum SiteBlockType {
  HERO
  TEXT
  IMAGE
  CTA
  FEATURES
  TESTIMONIAL
  FAQ
  FORM_EMBED
  HTML
  SPACER
  GALLERY
  VIDEO
}

enum SiteAnalyticsEvent {
  PAGEVIEW
  CLICK
  FORM_SUBMIT
}

model SiteTheme {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  tokens    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sites Site[]

  @@index([isDefault])
}

model Site {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  theme        Json?
  themeId      String?
  faviconUrl   String?
  customDomain String?  @unique
  published    Boolean  @default(false)
  homePageId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  siteTheme SiteTheme?      @relation(fields: [themeId], references: [id], onDelete: SetNull)
  pages     SitePage[]
  domains   SiteDomain[]
  analytics SiteAnalytics[]

  @@index([published])
}

model SitePage {
  id             String   @id @default(cuid())
  siteId         String
  slug           String
  title          String
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  published      Boolean  @default(false)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  site   Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  blocks SiteBlock[]

  @@unique([siteId, slug])
  @@index([siteId])
  @@index([published])
}

model SiteBlock {
  id        String        @id @default(cuid())
  pageId    String
  type      SiteBlockType
  order     Int           @default(0)
  data      Json
  visible   Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  page SitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model SiteDomain {
  id                String   @id @default(cuid())
  siteId            String
  domain            String   @unique
  verified          Boolean  @default(false)
  verificationToken String
  createdAt         DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model SiteAnalytics {
  id        String             @id @default(cuid())
  siteId    String
  pageId    String?
  eventType SiteAnalyticsEvent @default(PAGEVIEW)
  path      String?
  referrer  String?
  userAgent String?
  ipHash    String?
  createdAt DateTime           @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([pageId])
  @@index([eventType])
  @@index([createdAt])
}

// ── Sprint 18: Workflows / Visual Automation Builder ───────────────────────────

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum WorkflowRunStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELED
  WAITING
}

enum WorkflowStepStatus {
  SUCCESS
  FAILED
  SKIPPED
  WAITING
}

enum WorkflowVariableType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model Workflow {
  id                 String         @id @default(cuid())
  name               String
  description        String?
  status             WorkflowStatus @default(DRAFT)
  version            Int            @default(1)
  graph              Json
  entryTriggerType   String
  entryTriggerFilter Json?
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  runs      WorkflowRun[]
  variables WorkflowVariable[]

  @@index([status])
  @@index([entryTriggerType])
}

model WorkflowRun {
  id            String            @id @default(cuid())
  workflowId    String
  triggeredBy   Json?
  status        WorkflowRunStatus @default(RUNNING)
  startedAt     DateTime          @default(now())
  completedAt   DateTime?
  currentNodeId String?
  resumeAt      DateTime?
  context       Json?
  error         String?

  workflow Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepLogs WorkflowStepLog[]

  @@index([workflowId])
  @@index([status])
  @@index([resumeAt])
}

model WorkflowStepLog {
  id          String             @id @default(cuid())
  runId       String
  nodeId      String
  nodeType    String
  status      WorkflowStepStatus
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime           @default(now())
  completedAt DateTime?

  run WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model WorkflowVariable {
  id           String               @id @default(cuid())
  workflowId   String
  name         String
  type         WorkflowVariableType @default(STRING)
  defaultValue String?
  createdAt    DateTime             @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, name])
  @@index([workflowId])
}

// Sprint 19: Forms 2.0. A richer form builder (multi-step wizards, conditional
// visibility, calculations, payment fields) in a NEW namespace so the Sprint 5
// simple Form/FormSubmission models keep serving legacy /forms/[slug].

enum FormV2Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormFieldType {
  SHORT_TEXT
  LONG_TEXT
  EMAIL
  PHONE
  NUMBER
  DATE
  DATETIME
  SELECT
  MULTISELECT
  RADIO
  CHECKBOX
  FILE
  RATING
  SIGNATURE
  HIDDEN
  CALCULATED
  PAYMENT
  HEADING
  PARAGRAPH
}

enum FormV2SubmissionStatus {
  PENDING
  COMPLETED
  PAID
  FAILED
}

enum FormV2AnalyticsEvent {
  VIEW
  STEP_ADVANCE
  STEP_BACK
  SUBMIT_ATTEMPT
  SUBMIT_SUCCESS
  PAYMENT_INIT
  PAYMENT_SUCCESS
  PAYMENT_FAILED
}

model FormV2 {
  id                String       @id @default(cuid())
  name              String
  slug              String       @unique
  description       String?
  status            FormV2Status @default(DRAFT)
  successMessage    String?
  redirectUrl       String?
  submitButtonLabel String       @default("Submit")
  theme             Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  steps       FormStep[]
  fields      FormField[]
  submissions FormV2Submission[]
  analytics   FormV2Analytics[]

  @@index([status])
}

model FormStep {
  id          String  @id @default(cuid())
  formId      String
  order       Int     @default(0)
  title       String
  description String?

  form   FormV2      @relation(fields: [formId], references: [id], onDelete: Cascade)
  fields FormField[]

  @@index([formId])
}

model FormField {
  id             String        @id @default(cuid())
  formId         String
  stepId         String?
  order          Int           @default(0)
  key            String
  label          String
  type           FormFieldType @default(SHORT_TEXT)
  required       Boolean       @default(false)
  placeholder    String?
  helpText       String?
  options        Json?
  validation     Json?
  defaultValue   String?
  calculation    String?
  paymentAmount  Int?
  paymentCurrency String       @default("USD")
  paymentDescription String?
  visibilityRule Json?

  form FormV2    @relation(fields: [formId], references: [id], onDelete: Cascade)
  step FormStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@unique([formId, key])
  @@index([formId])
  @@index([stepId])
}

model FormV2Submission {
  id              String                 @id @default(cuid())
  formId          String
  status          FormV2SubmissionStatus @default(PENDING)
  data            Json
  meta            Json?
  leadId          String?
  contactId       String?
  amountCents     Int?
  currency        String                 @default("USD")
  paymentIntentId String?
  paidAt          DateTime?
  createdAt       DateTime               @default(now())

  form FormV2 @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([status])
}

model FormV2Analytics {
  id        String               @id @default(cuid())
  formId    String
  stepId    String?
  event     FormV2AnalyticsEvent
  path      String?
  referrer  String?
  ipHash    String?
  createdAt DateTime             @default(now())

  form FormV2 @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([event])
}

// Sprint 20: Inventory / Warehouse.
enum StockMovementType {
  RECEIPT
  SHIPMENT
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  RETURN
}

enum StockTransferStatus {
  DRAFT
  PENDING
  IN_TRANSIT
  RECEIVED
  CANCELED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELED
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  city      String?
  region    String?
  country   String?
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockItems     StockItem[]
  movements      StockMovement[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")
  purchaseOrders PurchaseOrder[]

  @@index([active])
}

model StockItem {
  id                     String    @id @default(cuid())
  productId              String
  warehouseId            String
  quantity               Int       @default(0)
  lowStockThreshold      Int       @default(10)
  reservedQuantity       Int       @default(0)
  locationCode           String?
  lastLowStockNotifiedAt DateTime?
  updatedAt              DateTime  @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@index([productId])
}

model StockMovement {
  id            String            @id @default(cuid())
  productId     String
  warehouseId   String
  type          StockMovementType
  quantity      Int
  unitCostCents Int?
  referenceType String?
  referenceId   String?
  note          String?
  createdById   String?
  createdAt     DateTime          @default(now())

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([warehouseId])
  @@index([type])
  @@index([createdAt])
}

model StockTransfer {
  id              String              @id @default(cuid())
  transferNumber  String              @unique
  fromWarehouseId String
  toWarehouseId   String
  status          StockTransferStatus @default(DRAFT)
  notes           String?
  createdById     String?
  createdAt       DateTime            @default(now())
  sentAt          DateTime?
  receivedAt      DateTime?

  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items         StockTransferItem[]

  @@index([status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model StockTransferItem {
  id               String @id @default(cuid())
  transferId       String
  productId        String
  quantity         Int
  receivedQuantity Int    @default(0)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([productId])
}

model Vendor {
  id           String   @id @default(cuid())
  name         String
  email        String?
  phone        String?
  contactName  String?
  address      String?
  city         String?
  region       String?
  country      String?
  taxId        String?
  paymentTerms String?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([active])
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  poNumber      String              @unique
  vendorId      String
  warehouseId   String
  status        PurchaseOrderStatus @default(DRAFT)
  subtotalCents Int                 @default(0)
  taxCents      Int                 @default(0)
  totalCents    Int                 @default(0)
  currency      String              @default("USD")
  expectedDate  DateTime?
  notes         String?
  createdAt     DateTime            @default(now())
  sentAt        DateTime?
  receivedAt    DateTime?

  vendor    Vendor              @relation(fields: [vendorId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  items     PurchaseOrderItem[]

  @@index([status])
  @@index([vendorId])
  @@index([warehouseId])
}

model PurchaseOrderItem {
  id               String @id @default(cuid())
  poId             String
  productId        String
  quantity         Int
  receivedQuantity Int    @default(0)
  unitCostCents    Int    @default(0)

  po      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([poId])
  @@index([productId])
}

// Sprint 21: Feed / Activity Stream - a company social feed with posts,
// threaded comments, reactions, polls, @mentions, follows, and view tracking.
// Authors/users are stored as clerk user id strings (no FK to a user table),
// matching the Chat models. Additive tenant-schema migration 0021_feed.

enum FeedPostType {
  POST
  ANNOUNCEMENT
  POLL
  QUESTION
  EVENT_SHARE
  RECORD_SHARE
  SYSTEM
}

enum FeedVisibility {
  PUBLIC
  PRIVATE_GROUP
  DIRECT
}

enum FeedSharedRecordType {
  DEAL
  CONTACT
  TASK
  DOCUMENT
}

enum FeedReactionKind {
  LIKE
  LOVE
  LAUGH
  WOW
  SAD
  THANKS
}

enum FeedFollowTargetType {
  POST
  USER
  RECORD
}

model FeedPost {
  id                   String                @id @default(cuid())
  authorId             String
  type                 FeedPostType          @default(POST)
  title                String?
  body                 String
  attachments          Json?
  sharedRecordType     FeedSharedRecordType?
  sharedRecordId       String?
  sharedRecordSnapshot Json?
  pinned               Boolean               @default(false)
  visibility           FeedVisibility        @default(PUBLIC)
  workgroupId          String?
  commentCount         Int                   @default(0)
  reactionCount        Int                   @default(0)
  viewCount            Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?

  comments  FeedComment[]
  reactions FeedReaction[]
  poll      FeedPoll?
  mentions  FeedMention[]
  views     FeedView[]

  @@index([type])
  @@index([authorId])
  @@index([pinned])
  @@index([createdAt])
  @@index([deletedAt])
}

model FeedComment {
  id              String    @id @default(cuid())
  postId          String
  parentCommentId String?
  authorId        String
  body            String
  attachments     Json?
  reactionCount   Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  post      FeedPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    FeedComment?   @relation("FeedCommentThread", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies   FeedComment[]  @relation("FeedCommentThread")
  reactions FeedReaction[]
  mentions  FeedMention[]

  @@index([postId])
  @@index([parentCommentId])
  @@index([authorId])
  @@index([createdAt])
}

model FeedReaction {
  id        String           @id @default(cuid())
  postId    String?
  commentId String?
  userId    String
  kind      FeedReactionKind
  createdAt DateTime         @default(now())

  post    FeedPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment FeedComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([commentId])
  @@index([userId])
}

model FeedPoll {
  id            String    @id @default(cuid())
  postId        String    @unique
  question      String
  allowMultiple Boolean   @default(false)
  closesAt      DateTime?
  closedAt      DateTime?

  post    FeedPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  options FeedPollOption[]
  votes   FeedPollVote[]
}

model FeedPollOption {
  id     String @id @default(cuid())
  pollId String
  label  String
  order  Int    @default(0)

  poll  FeedPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes FeedPollVote[]

  @@index([pollId])
}

model FeedPollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   FeedPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option FeedPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, optionId, userId])
  @@index([pollId])
  @@index([optionId])
}

model FeedMention {
  id              String   @id @default(cuid())
  postId          String?
  commentId       String?
  mentionedUserId String
  createdAt       DateTime @default(now())

  post    FeedPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment FeedComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([commentId])
  @@index([mentionedUserId])
}

model FeedFollow {
  id         String               @id @default(cuid())
  userId     String
  targetType FeedFollowTargetType
  targetId   String
  createdAt  DateTime             @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@index([targetType, targetId])
}

model FeedView {
  id       String   @id @default(cuid())
  postId   String
  userId   String
  viewedAt DateTime @default(now())

  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}
