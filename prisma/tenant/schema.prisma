enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum ProjectVisibility {
  PRIVATE
  TEAM
  TENANT
}

enum ProjectMemberRole {
  OWNER
  LEAD
  MEMBER
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
  CANCELED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskDependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

model Project {
  id               String            @id @default(cuid())
  key              String            @unique
  name             String
  description      String?
  status           ProjectStatus     @default(PLANNING)
  visibility       ProjectVisibility @default(TEAM)
  ownerClerkUserId String?
  startDate        DateTime?         @db.Date
  endDate          DateTime?         @db.Date
  budget           Decimal?          @db.Decimal(15, 2)
  color            String?
  parentProjectId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  parent   Project?        @relation("ProjectSubprojects", fields: [parentProjectId], references: [id], onDelete: SetNull)
  children Project[]       @relation("ProjectSubprojects")
  members  ProjectMember[]
  lists    TaskList[]
  tasks    Task[]
  timeEntries TimeEntry[]

  @@index([status])
  @@index([ownerClerkUserId])
  @@index([parentProjectId])
}

model ProjectMember {
  id          String            @id @default(cuid())
  projectId   String
  clerkUserId String
  role        ProjectMemberRole @default(MEMBER)
  joinedAt    DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, clerkUserId])
  @@index([clerkUserId])
}

model TaskList {
  id        String   @id @default(cuid())
  projectId String?
  name      String
  sortOrder Int      @default(0)
  color     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

model Task {
  id                   String       @id @default(cuid())
  projectId            String?
  listId               String?
  parentTaskId         String?
  title                String
  description          String?
  status               TaskStatus   @default(TODO)
  priority             TaskPriority @default(NORMAL)
  assigneeClerkUserId  String?
  reporterClerkUserId  String?
  dueAt                DateTime?
  startAt              DateTime?
  estimatedMinutes     Int?
  actualMinutes        Int          @default(0)
  progressPct          Int          @default(0)
  sortOrder            Int          @default(0)
  completedAt          DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?

  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  list        TaskList?        @relation(fields: [listId], references: [id], onDelete: SetNull)
  parent      Task?            @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks    Task[]           @relation("TaskSubtasks")
  predecessors TaskDependency[] @relation("TaskSuccessor")
  successors   TaskDependency[] @relation("TaskPredecessor")
  comments    TaskComment[]
  attachments TaskAttachment[]
  checklists  Checklist[]
  timeEntries TimeEntry[]

  @@index([projectId, status])
  @@index([assigneeClerkUserId])
  @@index([dueAt])
  @@index([parentTaskId])
  @@index([deletedAt])
}

model TaskDependency {
  id               String             @id @default(cuid())
  predecessorTaskId String
  successorTaskId   String
  type             TaskDependencyType @default(FINISH_TO_START)
  lagMinutes       Int                @default(0)
  createdAt        DateTime           @default(now())

  predecessor Task @relation("TaskPredecessor", fields: [predecessorTaskId], references: [id], onDelete: Cascade)
  successor   Task @relation("TaskSuccessor", fields: [successorTaskId], references: [id], onDelete: Cascade)

  @@unique([predecessorTaskId, successorTaskId])
  @@index([successorTaskId])
}

model TimeEntry {
  id              String    @id @default(cuid())
  taskId          String?
  projectId       String?
  clerkUserId     String
  description     String?
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int       @default(0)
  billable        Boolean   @default(false)
  hourlyRateCents Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([projectId])
  @@index([clerkUserId])
}

model TaskComment {
  id          String   @id @default(cuid())
  taskId      String
  clerkUserId String
  body        String
  mentions    Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskAttachment {
  id                   String   @id @default(cuid())
  taskId               String
  fileId               String
  attachedByClerkUserId String?
  createdAt            DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([fileId])
}

model Checklist {
  id        String   @id @default(cuid())
