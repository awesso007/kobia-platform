// =============================================================================
// KOBIA.AI — Prisma Schema
// =============================================================================
// Multi-tenant database schema.
// Every business table includes `tenantId` for row-level data isolation (Lock EEEE).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// CORE: Tenant model — the "T" in multi-tenant
// -----------------------------------------------------------------------------
model Tenant {
  id              String   @id @default(cuid())
  slug            String   @unique // subdomain: {slug}.kobia.ai
  name            String
  legalName       String?
  ein             String?
  // Billing
  tier            TenantTier @default(FREE)
  stripeCustomerId String?  @unique
  // Branding (Lock EEEE — tenant-controlled UI)
  logoUrl         String?
  primaryColor    String?  @default("#0F172A")
  secondaryColor  String?  @default("#3B82F6")
  hideKobiaBrand  Boolean  @default(false) // forced true on tier > ENTRY (Lock EEEE)
  customDomain    String?  @unique
  // Status
  isActive        Boolean  @default(true)
  suspendedAt     DateTime?
  suspendReason   String?
  // Onboarding
  onboardingCompleted Boolean  @default(false)
  onboardingStep      String?  // "industry" | "entity" | "team" | "done"
  industry            String?  // for default COA template — applied to first entity
  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Relations
  memberships     Membership[]
  apiKeys         ApiKey[]
  auditLogs       AuditLog[]
  subscription    Subscription?
  entities        Entity[]

  @@index([slug])
  @@index([tier])
}

enum TenantTier {
  FREE         // KOBIA brand shown ("Powered by KOBIA")
  ENTRY        // KOBIA brand shown
  SOLO         // KOBIA brand hidden — $149/mo
  FIRM         // KOBIA brand hidden — $399/mo
  FIRM_PLUS    // KOBIA brand hidden — $899/mo
  ENTERPRISE   // KOBIA brand hidden — custom pricing
  INTERNAL     // FIG and other KOBIA-owned tenants — free
}

// -----------------------------------------------------------------------------
// USER: One identity, can belong to multiple tenants
// -----------------------------------------------------------------------------
model User {
  id            String   @id @default(cuid())
  clerkUserId   String   @unique // Source of truth is Clerk
  email         String   @unique
  firstName     String?
  lastName      String?
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // Relations
  memberships   Membership[]
  auditLogs     AuditLog[]
}

/// A practice-management engagement — the unit of accounting work an accountant performs
/// for one of their client businesses (an Entity within the firm's tenant). Engagements
/// group together tasks, deadlines, and recurring service work.
model Engagement {
  id              String           @id @default(cuid())
  tenantId        String           // firm tenant
  entityId        String           // client business this engagement is for
  name            String           // e.g. "2026 Tax Return", "Monthly Bookkeeping"
  type            EngagementType   @default(BOOKKEEPING)
  status          EngagementStatus @default(ACTIVE)
  startDate       DateTime?
  targetDate      DateTime?
  completedAt     DateTime?
  notes           String?
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  entity          Entity           @relation(fields: [entityId], references: [id], onDelete: Cascade)
  tasks           Task[]
  letters         EngagementLetter[]
  practiceTimeEntries PracticeTimeEntry[]
  billingRates    BillingRate[]

  @@index([tenantId])
  @@index([entityId, status])
  @@index([tenantId, status])
}

/// A single task within an Engagement — the atomic unit of accountant work.
model Task {
  id              String       @id @default(cuid())
  tenantId        String
  engagementId    String
  title           String
  description     String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MED)
  dueDate         DateTime?
  assigneeUserId  String?      // membership.user.id
  completedAt     DateTime?
  sortOrder       Int          @default(0)
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  engagement      Engagement   @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([engagementId, status, sortOrder])
  @@index([assigneeUserId, status])
}

enum EngagementType {
  BOOKKEEPING
  TAX
  PAYROLL
  AUDIT
  ADVISORY
  ONBOARDING
  OTHER
}

enum EngagementStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MED
  HIGH
  URGENT
}

/// Reusable engagement-letter templates per tenant (firm).
model EngagementLetterTemplate {
  id              String         @id @default(cuid())
  tenantId        String
  name            String         // "2026 Tax Return Letter", "Monthly Bookkeeping"
  engagementType  EngagementType @default(BOOKKEEPING)
  subject         String         // shown to client
  bodyMarkdown    String         // supports {{client_name}}, {{firm_name}}, {{engagement_name}}, {{start_date}}, {{target_date}}, {{fee_amount}}, {{today}}, {{signer_name}}
  feeText         String?        // e.g. "$2,500 flat fee" — optional default
  isActive        Boolean        @default(true)
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  letters         EngagementLetter[]

  @@index([tenantId, isActive])
  @@index([tenantId, engagementType])
}

/// A specific engagement letter generated for an engagement.
model EngagementLetter {
  id              String       @id @default(cuid())
  tenantId        String
  engagementId    String
  templateId      String?
  subject         String
  bodyMarkdown    String        // post-variable-substitution body
  feeText         String?
  status          LetterStatus  @default(DRAFT)
  sentAt          DateTime?
  signedAt        DateTime?
  signerName      String?
  signerEmail     String?
  voidedAt        DateTime?
  voidedReason    String?
  shareToken      String?       @unique // for client view/sign link
  createdByUserId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  engagement      Engagement                 @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  template        EngagementLetterTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([engagementId, status])
}

enum LetterStatus {
  DRAFT
  SENT
  SIGNED
  VOIDED
}

// -----------------------------------------------------------------------------
// MEMBERSHIP: User <-> Tenant join with role (Lock HHH role-aware UI)
// -----------------------------------------------------------------------------
model Membership {
  id          String   @id @default(cuid())
  userId      String
  tenantId    String
  role        Role
  // Tenant-specific user details
  title       String?
  isActive    Boolean  @default(true)
  invitedAt   DateTime @default(now())
  acceptedAt  DateTime?
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

enum Role {
  OWNER         // Tenant owner — full control including billing
  ADMIN         // Admin — manages users, settings, all modules
  ACCOUNTANT    // Accountant role — full access to books/payroll/invoicing/AP
  STAFF         // Staff role — limited access
  CLIENT        // Tenant's client — limited access to their own data only (portal)
  VIEWER        // Read-only across modules
}

// -----------------------------------------------------------------------------
// API KEYS: For tenant integrations (Cycle 4+)
// -----------------------------------------------------------------------------
model ApiKey {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  keyHash     String   @unique // store hash, not raw key
  prefix      String   // first 8 chars shown in UI
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([keyHash])
}

// -----------------------------------------------------------------------------
// AUDIT LOG: Every action gets logged (SOC 2 prep)
// -----------------------------------------------------------------------------
model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  action      String   // e.g. "tenant.created", "user.invited", "invoice.sent"
  entityType  String?  // e.g. "Invoice", "Bill"
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([action])
}

// -----------------------------------------------------------------------------
// SUBSCRIPTION: KOBIA's own billing (Cycle 1 Week 2 — Stripe)
// -----------------------------------------------------------------------------
model Subscription {
  id                    String    @id @default(cuid())
  tenantId              String    @unique
  stripeSubscriptionId  String    @unique
  stripePriceId         String
  status                SubStatus
  tier                  TenantTier
  // Trial
  trialStart            DateTime?
  trialEnd              DateTime?
  // Billing cycle
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean   @default(false)
  canceledAt            DateTime?
  // Metadata
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  // Relations
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([currentPeriodEnd])
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAUSED
}

// =============================================================================
// CYCLE 2 — BOOKKEEPING CORE (Chart of Accounts + General Ledger)
// =============================================================================
// Double-entry accounting. Every JournalEntry has 2+ JournalLines.
// Sum of debits = sum of credits per entry (enforced at app layer + DB constraint).
// =============================================================================

/// Entity = a single business's books inside a tenant. Firms manage many entities.
model Entity {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  legalName     String?
  ein           String?
  fiscalYearEnd String?  // "12-31", "06-30", etc.
  baseCurrency  String   @default("USD") // ISO 4217
  industry      String?  // for chart of accounts templates
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts        Account[]
  journalEntries  JournalEntry[]
  customers       Customer[]
  invoices        Invoice[]
  vendors         Vendor[]
  bills           Bill[]
  bankAccounts    BankAccount[]
  periods         AccountingPeriod[]
  recurringInvoices RecurringInvoice[]
  recurringBills    RecurringBill[]
  budgets           Budget[]
  approvalRule      ApprovalRule?
  mileageEntries    Mileage[]
  taxRates          TaxRate[]
  employees         Employee[]
  payRuns           PayRun[]
  items             Item[]
  recurringJEs      RecurringJournalEntry[]
  engagements       Engagement[]
  recurringEngagements RecurringEngagement[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// A bookkeeping period (typically a month). Once status=CLOSED,
/// no journal entries with entryDate inside the window can post.
model AccountingPeriod {
  id             String          @id @default(cuid())
  tenantId       String          // denormalized for tenant isolation
  entityId       String
  startDate      DateTime        // inclusive (UTC midnight)
  endDate        DateTime        // inclusive (UTC midnight, last day of period)
  label          String          // e.g. "May 2026", "Q2 2026"
  status         PeriodStatus    @default(OPEN)
  closedAt       DateTime?
  closedByUserId String?
  closingNote    String?
  reopenedAt     DateTime?
  reopenedByUserId String?
  reopenReason   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, startDate])
  @@index([tenantId, entityId])
  @@index([entityId, status])
}

enum PeriodStatus {
  OPEN
  CLOSED
}

/// A capitalized fixed asset depreciated over its useful life.
/// Posts a single capitalization JE on creation (debit asset account, credit cash or AP).
/// Monthly depreciation JEs debit depreciation expense, credit accumulated depreciation.
model FixedAsset {
  id                       String    @id @default(cuid())
  tenantId                 String
  entityId                 String
  name                     String
  description              String?
  category                 String?   // e.g. "Equipment", "Vehicle", "Computer", "Furniture"
  acquisitionDate          DateTime  // when placed in service
  costCents                BigInt    // capitalized cost in cents
  salvageValueCents        BigInt    @default(0)
  usefulLifeMonths         Int       // e.g. 60 for 5 years
  method                   DepreciationMethod @default(STRAIGHT_LINE)
  status                   FixedAssetStatus   @default(ACTIVE)
  disposedDate             DateTime?
  disposedNotes            String?
  // Accounting links
  assetAccountId           String    // balance sheet account where the asset lives
  accumulatedDepreciationAccountId String // contra-asset
  depreciationExpenseAccountId String // P&L expense
  // Audit
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  createdByUserId          String?

  depreciationEntries DepreciationEntry[]

  @@index([tenantId, entityId])
  @@index([entityId, status])
  @@index([entityId, acquisitionDate])
}

/// One row per posted month of depreciation for a fixed asset.
/// Always backed by a JournalEntry so reports stay consistent.
model DepreciationEntry {
  id              String      @id @default(cuid())
  tenantId        String
  fixedAssetId    String
  periodStart     DateTime    // month start (UTC midnight)
  periodEnd       DateTime    // month end
  amountCents     BigInt
  journalEntryId  String      @unique
  postedAt        DateTime    @default(now())
  postedByUserId  String?

  fixedAsset FixedAsset @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)

  @@unique([fixedAssetId, periodStart])
  @@index([tenantId])
}

enum DepreciationMethod {
  STRAIGHT_LINE
  // DOUBLE_DECLINING / SUM_OF_YEARS_DIGITS can be added later
}

enum FixedAssetStatus {
  ACTIVE
  FULLY_DEPRECIATED
  DISPOSED
}

/// Tenant-scoped exchange rate. Latest row per (tenantId, fromCurrency, toCurrency, rateDate).
/// Stored as Decimal for precision (e.g. 1.36500000 CAD per USD).
model ExchangeRate {
  id           String   @id @default(cuid())
  tenantId     String
  fromCurrency String   // ISO 4217
  toCurrency   String   // ISO 4217
  rate         Decimal  @db.Decimal(18, 8)
  rateDate     DateTime // UTC midnight of the effective day
  source       String?  // "manual" | "frankfurter" | "ecb" — informational
  createdAt    DateTime @default(now())
  createdByUserId String?

  @@unique([tenantId, fromCurrency, toCurrency, rateDate])
  @@index([tenantId, fromCurrency, toCurrency])
  @@index([tenantId, rateDate])
}

/// Chart of Accounts node. Hierarchical via parentId.
model Account {
  id            String      @id @default(cuid())
  tenantId      String      // denormalized for query speed + Lock EEEE isolation
  entityId      String
  code          String      // e.g., "1000", "1010", "4000"
  name          String      // e.g., "Cash and equivalents"
  type          AccountType
  subtype       String?     // e.g., "Bank", "Accounts Receivable", "Cost of Goods Sold"
  parentId      String?
  description   String?
  isActive      Boolean     @default(true)
  isSystem      Boolean     @default(false) // protected (e.g., "Retained Earnings")
  // Optional 1099-MISC box assignment (1=Rents, 2=Royalties, 3=Other Income, 6=Medical, 14=Gross Atty)
  misc1099Box   Int?
  // Cached balance updated on each journal post (denormalized for speed)
  balanceCents  BigInt      @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  entity            Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  parent            Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children          Account[]     @relation("AccountHierarchy")
  journalLines      JournalLine[]
  invoiceLines      InvoiceLine[]
  invoicePayments   InvoicePayment[] @relation("InvoicePaymentCashAccount")
  billLines         BillLine[]
  billPayments      BillPayment[]    @relation("BillPaymentCashAccount")
  bankAccounts      BankAccount[]
  itemsAsRevenue    Item[]           @relation("ItemRevenueAccount")
  itemsAsInventory  Item[]           @relation("ItemInventoryAccount")
  itemsAsCogs       Item[]           @relation("ItemCogsAccount")
  recurringInvoiceLines RecurringInvoiceLine[]
  recurringBillLines    RecurringBillLine[]
  budgetLines           BudgetLine[]
  recurringJELines      RecurringJournalLine[]

  @@unique([entityId, code])
  @@index([tenantId])
  @@index([entityId, type])
  @@index([parentId])
}

/// Standard accounting account categories. Drives reporting + normal balance side.
enum AccountType {
  ASSET         // Debit normal balance
  LIABILITY     // Credit normal balance
  EQUITY        // Credit normal balance
  REVENUE       // Credit normal balance
  EXPENSE       // Debit normal balance
  COGS          // Debit normal balance (Cost of Goods Sold subtype of Expense, broken out for P&L)
  OTHER_INCOME  // Credit normal balance
  OTHER_EXPENSE // Debit normal balance
}

/// A single journal entry. Header for 2+ JournalLines.
model JournalEntry {
  id            String       @id @default(cuid())
  tenantId      String
  entityId      String
  entryNumber   Int          // sequential per entity, set on post
  entryDate     DateTime     // accounting date (may differ from createdAt)
  description   String?
  memo          String?
  source        EntrySource  @default(MANUAL)
  sourceRefId   String?      // e.g., "bill_xxx", "invoice_xxx", "bankTxn_xxx"
  status        EntryStatus  @default(DRAFT)
  postedAt      DateTime?
  postedByUserId String?
  reversedById  String?      @unique // points to the reversing JE if this was reversed
  reversalOfId  String?      @unique // points to the original JE if this IS a reversal
  // Period lock (Lock from year-end close workflow)
  periodLocked  Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  entity        Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  lines         JournalLine[]
  reversedBy    JournalEntry? @relation("JournalReversal", fields: [reversedById], references: [id])
  reversalOf    JournalEntry? @relation("JournalReversal")
  attachments   Attachment[]

  @@unique([entityId, entryNumber])
  @@index([tenantId])
  @@index([entityId, entryDate])
  @@index([entityId, status])
  @@index([source, sourceRefId])
}

/// File or URL attached to a Bill, Invoice, or JournalEntry — receipts, contracts, statements.
/// Stores either an external URL (fastest path) or a Vercel Blob upload URL when token configured.
model Attachment {
  id             String   @id @default(cuid())
  tenantId       String
  entityId       String
  // Exactly one of billId / invoiceId / journalEntryId is set (enforced in app layer).
  billId         String?
  invoiceId      String?
  journalEntryId String?
  filename       String
  url            String   // external link OR vercel blob URL
  contentType    String?  // e.g., "application/pdf", "image/jpeg"
  sizeBytes      Int?
  storage        AttachmentStorage @default(URL)
  uploadedByUserId String?
  notes          String?
  createdAt      DateTime @default(now())

  bill           Bill?         @relation(fields: [billId], references: [id], onDelete: Cascade)
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([billId])
  @@index([invoiceId])
  @@index([journalEntryId])
}

enum AttachmentStorage {
  URL          // external link only — no upload
  VERCEL_BLOB  // hosted in Vercel Blob (requires BLOB_READ_WRITE_TOKEN)
}

/// A recurring journal entry template — runs on a fixed schedule (monthly depreciation,
/// quarterly accruals, weekly payroll accrual, etc.). Each run posts a real JournalEntry via
/// the ledger engine and advances nextRunDate by the chosen frequency.
model RecurringJournalEntry {
  id            String                    @id @default(cuid())
  tenantId      String
  entityId      String
  name          String                    // e.g., "Monthly depreciation — vehicles"
  description   String?                   // copied to each posted JE.description
  memo          String?                   // copied to each posted JE.memo
  frequency     RecurringFrequency        @default(MONTHLY)
  nextRunDate   DateTime                  // next entry date to post (also used as JE.entryDate)
  lastRunDate   DateTime?
  endDate       DateTime?                 // stop after this date; null = forever
  isActive      Boolean                   @default(true)
  runCount      Int                       @default(0)
  createdByUserId String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  entity        Entity                    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  lines         RecurringJournalLine[]

  @@index([tenantId])
  @@index([entityId, isActive, nextRunDate])
}

/// A single template line on a RecurringJournalEntry. Mirrors JournalLine fields.
model RecurringJournalLine {
  id              String                @id @default(cuid())
  tenantId        String
  recurringId     String
  accountId       String
  debitCents      BigInt                @default(0)
  creditCents     BigInt                @default(0)
  memo            String?
  classTag        String?
  locationTag     String?
  departmentTag   String?
  lineNumber      Int

  recurring       RecurringJournalEntry @relation(fields: [recurringId], references: [id], onDelete: Cascade)
  account         Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([recurringId, lineNumber])
  @@index([tenantId])
}

enum EntrySource {
  MANUAL          // accountant typed it
  BANK_FEED       // from Plaid/Finicity import
  INVOICE         // generated by an AR invoice
  BILL            // generated by an AP bill
  PAYMENT         // payment received or sent
  PAYROLL         // generated by a pay run
  ADJUSTMENT      // closing/adjusting entry
  OPENING_BALANCE // initial balances on entity creation
  AI_SUGGESTED    // generated by AI, awaiting approval
  IMPORT          // CSV/QBO migration
  DEPRECIATION    // automatic monthly fixed-asset depreciation
  ASSET_PURCHASE  // capitalization of a fixed asset
}

enum EntryStatus {
  DRAFT     // editable
  POSTED    // committed to ledger, balances updated
  REVERSED  // superseded by a reversing entry
  VOID      // canceled before post (DRAFT only)
}

/// One side of a journal entry. Debit OR credit, never both.
model JournalLine {
  id            String   @id @default(cuid())
  tenantId      String
  journalEntryId String
  accountId     String
  // Use BigInt cents to avoid floating-point error
  debitCents    BigInt   @default(0)
  creditCents   BigInt   @default(0)
  memo          String?
  // Dimensional tagging (Lock B6 — class/location/department)
  classTag      String?
  locationTag   String?
  departmentTag String?
  // For multi-entity / intercompany (future)
  contactRefType String? // "Customer", "Vendor", "Employee"
  contactRefId   String?
  lineNumber    Int      // ordering within the entry
  createdAt     DateTime @default(now())

  journalEntry  JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([journalEntryId])
  @@index([accountId])
  @@index([classTag])
  @@index([locationTag])
}

// =============================================================================
// ACCOUNTS RECEIVABLE — Cycle 3 (Customer, Invoice, InvoiceLine, InvoicePayment)
// =============================================================================

enum InvoiceStatus {
  DRAFT     // not posted to ledger, editable
  OPEN      // posted, balance > 0
  PARTIAL   // posted, partially paid
  PAID      // fully paid
  VOID      // cancelled (reverses original JE)
}

/// AR customer record — scoped to a single entity within a tenant.
model Customer {
  id            String   @id @default(cuid())
  tenantId      String
  entityId      String
  name          String
  email         String?
  phone         String?
  // Default net-terms in days (15, 30, 60). Used to compute dueDate when not specified.
  defaultTermsDays Int   @default(30)
  billingAddress String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entity   Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  recurringInvoices RecurringInvoice[]

  @@unique([entityId, name])
  @@index([tenantId])
  @@index([entityId, isActive])
}

/// Customer invoice. Posts to ledger when status moves DRAFT -> OPEN.
model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  entityId       String
  customerId     String
  invoiceNumber  Int           // sequential per entity, set when posted
  issueDate      DateTime
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  // Money columns (cents, BigInt)
  subtotalCents  BigInt        @default(0)
  taxCents       BigInt        @default(0)
  totalCents     BigInt        @default(0)
  paidCents      BigInt        @default(0)
  // Convenience: totalCents - paidCents, recomputed on payment
  balanceCents   BigInt        @default(0)
  memo           String?
  // Currency: ISO 4217 code. If different from the entity baseCurrency, fxRate is set.
  currency       String        @default("USD")
  fxRate         Decimal?      @db.Decimal(18, 8) // rate: 1 invoice-currency = fxRate base-currency
  baseTotalCents BigInt        @default(0)
  // Link to the posting JE (created when invoice goes OPEN)
  postingJournalEntryId String? @unique
  postedAt       DateTime?
  voidedAt       DateTime?
  // Public portal access — long random token; null if portal disabled
  publicViewToken String?      @unique
  // Optional sales tax rate applied at post time. Snapshot stored in taxRateBps + taxCents.
  taxRateId      String?
  taxRateBps     Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  entity   Entity            @relation(fields: [entityId], references: [id], onDelete: Cascade)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  taxRate  TaxRate?          @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  lines    InvoiceLine[]
  payments InvoicePayment[]
  recurringRun RecurringInvoiceRun?
  attachments Attachment[]

  @@unique([entityId, invoiceNumber])
  @@index([tenantId])
  @@index([entityId, status])
  @@index([customerId, status])
  @@index([dueDate])
}

/// Catalog of sellable items (services + inventory).
/// INVENTORY items track on-hand quantity and post COGS when sold via invoice.
model Item {
  id                    String     @id @default(cuid())
  tenantId              String
  entityId              String
  sku                   String?
  name                  String
  description           String?
  type                  ItemType   @default(SERVICE)
  unitPriceCents        BigInt     @default(0)    // default sales price
  unitCostCents         BigInt     @default(0)    // avg cost — used as COGS unit on sale
  qtyOnHandMilli        BigInt     @default(0)    // tracked for INVENTORY only
  // GL account links
  revenueAccountId      String
  inventoryAccountId    String?                    // required for INVENTORY (asset)
  cogsAccountId         String?                    // required for INVENTORY (expense)
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  entity            Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  revenueAccount    Account  @relation("ItemRevenueAccount",   fields: [revenueAccountId],   references: [id], onDelete: Restrict)
  inventoryAccount  Account? @relation("ItemInventoryAccount", fields: [inventoryAccountId], references: [id], onDelete: Restrict)
  cogsAccount       Account? @relation("ItemCogsAccount",      fields: [cogsAccountId],      references: [id], onDelete: Restrict)
  invoiceLines      InvoiceLine[]

  @@unique([entityId, sku])
  @@index([tenantId])
  @@index([entityId, isActive])
}

enum ItemType {
  SERVICE
  INVENTORY
}

/// One line on an invoice. Debits AR / credits a revenue account when posted.
model InvoiceLine {
  id            String   @id @default(cuid())
  tenantId      String
  invoiceId     String
  // Revenue account this line credits when posted
  accountId     String
  // Optional catalog item (drives COGS posting for INVENTORY items)
  itemId        String?
  description   String
  // Quantity stored as integer thousandths (3 decimal places) to support fractional units
  quantityMilli BigInt   @default(1000)
  unitPriceCents BigInt  @default(0)
  amountCents   BigInt   @default(0)   // quantityMilli/1000 * unitPriceCents, rounded
  lineNumber    Int
  createdAt     DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  item    Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([accountId])
}

/// Customer payment applied to an invoice. Debits cash / credits AR when posted.
model InvoicePayment {
  id            String   @id @default(cuid())
  tenantId      String
  invoiceId     String
  paymentDate   DateTime
  amountCents   BigInt
  // Cash/bank account this payment debits
  cashAccountId String
  method        String?  // "check", "ach", "card", "cash"
  reference     String?  // check #, etc.
  // Link to the JE that recorded the payment
  journalEntryId String? @unique
  createdAt     DateTime @default(now())

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  cashAccount Account @relation("InvoicePaymentCashAccount", fields: [cashAccountId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([paymentDate])
}

// =============================================================================
// ACCOUNTS PAYABLE (AP) — Vendors, Bills, BillPayments
// Mirror of AR: bills credit AP (LIABILITY), payments debit AP / credit cash.
// =============================================================================

enum BillStatus {
  DRAFT             // not posted to ledger, editable
  PENDING_APPROVAL  // submitted, awaiting approver
  OPEN              // posted, balance > 0
  PARTIAL           // posted, partially paid
  PAID              // fully paid
  VOID              // cancelled (reverses original JE)
  REJECTED          // approver rejected; back to draft-like state
}

/// AP vendor record — scoped to a single entity within a tenant.
model Vendor {
  id            String   @id @default(cuid())
  tenantId      String
  entityId      String
  name          String
  email         String?
  phone         String?
  // Default net-terms in days vendor extends to us.
  defaultTermsDays Int   @default(30)
  remitToAddress String?
  // For 1099 / W-9 tracking (Cycle 4 expansion)
  taxId         String?
  is1099Vendor  Boolean  @default(false)
  // 1099-MISC tracking (Box 1 Rents, Box 2 Royalties, Box 3 Other Income).
  is1099MiscVendor Boolean @default(false)
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  bills  Bill[]
  recurringBills RecurringBill[]

  @@unique([entityId, name])
  @@index([tenantId])
  @@index([entityId, isActive])
}

/// Business mileage log. Posts a JE at the IRS standard rate when status=POSTED.
/// Default IRS rate for 2026 is 70¢/mile (configurable per entry).
model Mileage {
  id             String         @id @default(cuid())
  tenantId       String
  entityId       String
  tripDate       DateTime
  fromAddress    String?
  toAddress      String?
  miles          Decimal        @db.Decimal(8, 2)
  ratePerMileCents Int          @default(70) // 2026 IRS standard mileage rate
  businessPercent Int           @default(100) // 0-100
  purpose         String?
  // After posting, deductible expense in cents = round(miles * businessPercent/100 * ratePerMileCents)
  expenseCents   BigInt         @default(0)
  status         MileageStatus  @default(DRAFT)
  // When posted, the JE that recorded the mileage expense
  journalEntryId String?        @unique
  createdByUserId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  entity         Entity         @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([entityId, tripDate])
  @@index([entityId, status])
}

enum MileageStatus {
  DRAFT
  POSTED
  VOID
}

/// An employee on payroll. The minimal model for Cycle 5 — we'll add tax
/// withholding, benefits, and direct-deposit info as the payroll engine matures.
model Employee {
  id                 String           @id @default(cuid())
  tenantId           String
  entityId           String
  firstName          String
  lastName           String
  email              String?
  // Optional: link to a KOBIA user account if the employee also has a login
  userId             String?
  // Compensation
  payType            PayType
  // For SALARY: annual amount in cents. For HOURLY: hourly rate in cents.
  payRateCents       BigInt
  // For HOURLY: standard hours per pay period (e.g. 80 for biweekly full-time)
  standardHoursPerPeriod Decimal?     @db.Decimal(6, 2)
  // Identification
  workEmail          String?
  homeAddress        String?
  ssnLast4           String?         // store last 4 only; never the full SSN here
  taxFilingStatus    String?         // "SINGLE", "MARRIED_JOINT", etc.
  taxAllowances      Int?            @default(0)
  // Lifecycle
  hireDate           DateTime?
  terminationDate    DateTime?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  entity             Entity          @relation(fields: [entityId], references: [id], onDelete: Cascade)
  paystubs           Paystub[]
  timeEntries        TimeEntry[]

  @@index([tenantId])
  @@index([entityId, isActive])
}

enum PayType {
  SALARY
  HOURLY
  CONTRACTOR
}

/// A pay run — the act of cutting checks for a period. Generates Paystub rows.
model PayRun {
  id                 String         @id @default(cuid())
  tenantId           String
  entityId           String
  periodStart        DateTime
  periodEnd          DateTime
  payDate            DateTime
  status             PayRunStatus   @default(DRAFT)
  // Aggregates (cents)
  totalGrossCents    BigInt         @default(0)
  totalNetCents      BigInt         @default(0)
  totalTaxesCents    BigInt         @default(0)
  // Posting
  journalEntryId     String?        @unique
  postedAt           DateTime?
  postedByUserId     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  entity             Entity         @relation(fields: [entityId], references: [id], onDelete: Cascade)
  paystubs           Paystub[]

  @@index([tenantId])
  @@index([entityId, status])
  @@index([entityId, payDate])
}

enum PayRunStatus {
  DRAFT
  POSTED
  VOID
}

/// A single employee's pay for a given pay run.
model Paystub {
  id                 String         @id @default(cuid())
  tenantId           String
  payRunId           String
  employeeId         String
  // Earnings (cents)
  regularHoursMilli  BigInt         @default(0) // hours * 1000
  overtimeHoursMilli BigInt         @default(0)
  regularPayCents    BigInt         @default(0)
  overtimePayCents   BigInt         @default(0)
  bonusCents         BigInt         @default(0)
  grossCents         BigInt         @default(0)
  // Withholdings (cents) — placeholders; real engine lands in Cycle 5 W3
  federalTaxCents    BigInt         @default(0)
  stateTaxCents      BigInt         @default(0)
  socialSecurityCents BigInt        @default(0)
  medicareCents      BigInt         @default(0)
  otherDeductionsCents BigInt       @default(0)
  netCents           BigInt         @default(0)
  createdAt          DateTime       @default(now())

  payRun             PayRun         @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  employee           Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([payRunId, employeeId])
  @@index([tenantId])
  @@index([employeeId])
}

/// A time entry — hours worked on a date, optionally with a class/department tag.
model TimeEntry {
  id                 String         @id @default(cuid())
  tenantId           String
  employeeId         String
  workDate           DateTime
  hoursMilli         BigInt         // hours * 1000
  isOvertime         Boolean        @default(false)
  notes              String?
  // When pushed into a PayRun, gets stamped with the paystub id.
  paystubId          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  employee           Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId, workDate])
}

/// A sales-tax rate the entity charges on invoices.
/// e.g. "CA Sales Tax" 7.25%. Stored as basis points (10000 = 100%).
model TaxRate {
  id            String   @id @default(cuid())
  tenantId      String
  entityId      String
  name          String   // "CA Sales Tax", "NY Sales Tax", etc.
  jurisdiction  String?  // e.g. "CA", "NY", "Riverside County"
  rateBps       Int      // basis points; 725 = 7.25%
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entity        Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  invoices      Invoice[]

  @@unique([entityId, name])
  @@index([tenantId])
  @@index([entityId, isActive])
}

/// Vendor bill. Posts to ledger when status moves DRAFT -> OPEN.
model Bill {
  id             String     @id @default(cuid())
  tenantId       String
  entityId       String
  vendorId       String
  // Vendor's own invoice/bill number (e.g., "INV-2026-001"). Optional, free text.
  vendorBillNumber String?
  // Sequential per entity, set when posted (internal AP doc number).
  billNumber     Int
  billDate       DateTime
  dueDate        DateTime
  status         BillStatus @default(DRAFT)
  subtotalCents  BigInt     @default(0)
  taxCents       BigInt     @default(0)
  totalCents     BigInt     @default(0)
  paidCents      BigInt     @default(0)
  balanceCents   BigInt     @default(0)
  memo           String?
  currency       String     @default("USD")
  fxRate         Decimal?   @db.Decimal(18, 8)
  baseTotalCents BigInt     @default(0)
  postingJournalEntryId String? @unique
  postedAt       DateTime?
  voidedAt       DateTime?
  // Public vendor portal view token (long random) — lets vendor see status of their own bill.
  publicViewToken String?   @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  entity   Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  vendor   Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines    BillLine[]
  payments BillPayment[]
  recurringRun RecurringBillRun?
  approvals BillApproval[]
  attachments Attachment[]

  @@unique([entityId, billNumber])
  @@index([tenantId])
  @@index([entityId, status])
  @@index([entityId, billDate])
  @@index([vendorId])
}

/// Expense or asset line on a vendor bill. Debits the chosen account when posted.
model BillLine {
  id            String   @id @default(cuid())
  tenantId      String
  billId        String
  // Expense or asset account this line debits when posted
  accountId     String
  description   String
  // Quantity stored as integer thousandths (3 decimal places).
  quantityMilli BigInt   @default(1000)
  unitPriceCents BigInt  @default(0)
  amountCents   BigInt   @default(0)
  lineNumber    Int
  createdAt     DateTime @default(now())

  bill    Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([billId])
  @@index([accountId])
}

/// Payment made to a vendor. Credits cash / debits AP when posted.
model BillPayment {
  id            String   @id @default(cuid())
  tenantId      String
  billId        String
  paymentDate   DateTime
  amountCents   BigInt
  // Cash/bank account this payment credits
  cashAccountId String
  method        String?  // "check", "ach", "card", "cash", "wire"
  reference     String?  // check #, confirmation #, etc.
  // Link to the JE that recorded the payment
  journalEntryId String? @unique
  createdAt     DateTime @default(now())

  bill        Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  cashAccount Account @relation("BillPaymentCashAccount", fields: [cashAccountId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([billId])
  @@index([paymentDate])
}

// =============================================================================
// BANK RECONCILIATION — Cycle 3 W3
// =============================================================================

/// A real-world bank/credit-card account, linked to a GL cash/liability account.
/// One GL account can have at most one BankAccount.
model BankAccount {
  id              String   @id @default(cuid())
  tenantId        String
  entityId        String
  // The GL account this bank account posts to (must be ASSET for bank, LIABILITY for credit card)
  glAccountId     String   @unique
  name            String   // Display name e.g. "Chase Business Checking …4521"
  institution     String?  // "Chase", "Bank of America"
  accountLast4    String?  // "4521"
  accountType     BankAccountType @default(CHECKING)
  currency        String   @default("USD")
  // Optional opening balance snapshot for first reconciliation
  openingBalanceCents BigInt @default(0)
  openingBalanceDate  DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entity        Entity                 @relation(fields: [entityId], references: [id], onDelete: Cascade)
  glAccount     Account                @relation(fields: [glAccountId], references: [id], onDelete: Restrict)
  transactions  BankTransaction[]
  rules         BankRule[]
  sessions      ReconciliationSession[]

  @@index([tenantId])
  @@index([entityId, isActive])
}

enum BankAccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  MONEY_MARKET
  LOAN
  OTHER
}

/// A single transaction line imported from a bank feed or CSV statement.
/// `amountCents` is signed: positive = money in (deposit), negative = money out (withdrawal).
model BankTransaction {
  id              String   @id @default(cuid())
  tenantId        String
  bankAccountId   String
  postedDate      DateTime
  description     String
  amountCents     BigInt   // signed; +inflow / -outflow
  balanceAfterCents BigInt? // optional, if statement provides running balance
  // Stable hash for dedup: SHA-1(postedDate|amount|description) — set on import
  dedupHash       String
  source          BankTxnSource @default(CSV_IMPORT)
  rawData         Json?    // original CSV row or feed payload
  status          BankTxnStatus @default(UNMATCHED)
  // When matched to an existing JE (e.g. invoice payment, bill payment, manual JE)
  matchedJournalEntryId String?
  matchedAt       DateTime?
  matchedByUserId String?
  // When categorized (creates a NEW JE) instead of matched
  categorizedJournalEntryId String?
  categorizedAt   DateTime?
  categorizedByUserId String?
  // Reconciliation session this txn was cleared in (set on session complete)
  reconciliationId String?
  clearedAt        DateTime?
  // Optional rule that auto-categorized this
  appliedRuleId   String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bankAccount     BankAccount            @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  reconciliation  ReconciliationSession? @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)
  appliedRule     BankRule?              @relation(fields: [appliedRuleId], references: [id], onDelete: SetNull)

  @@unique([bankAccountId, dedupHash])
  @@index([tenantId])
  @@index([bankAccountId, status])
  @@index([bankAccountId, postedDate])
  @@index([matchedJournalEntryId])
  @@index([categorizedJournalEntryId])
  @@index([reconciliationId])
}

enum BankTxnSource {
  CSV_IMPORT
  MANUAL
  PLAID         // future
  STRIPE_FEED   // future
}

enum BankTxnStatus {
  UNMATCHED   // imported, not yet matched or categorized
  MATCHED     // tied to an existing JE
  CATEGORIZED // a new JE was created from this txn
  CLEARED     // included in a completed reconciliation session
  IGNORED     // user marked as not-for-books (transfer between own accts, etc.)
}

/// User-defined or AI-suggested rule for auto-categorizing future bank txns.
/// Example: description contains "ADOBE" → debit 6600 Software & Subscriptions, credit this bank account.
model BankRule {
  id              String   @id @default(cuid())
  tenantId        String
  bankAccountId   String   // scope to a single bank account (null = entity-wide future)
  name            String
  // Match criteria — for MVP: simple substring match on description
  descriptionContains String
  // Optional: only apply if amount sign matches
  appliesToInflow  Boolean @default(true)
  appliesToOutflow Boolean @default(true)
  // Categorization target
  offsetAccountId String   // The account to debit (outflow) or credit (inflow) opposite of bank
  memoTemplate    String?  // Optional memo to set on created JE
  contactRefType  String?  // "Vendor", "Customer", etc.
  contactRefId    String?
  // Stats
  appliedCount    Int      @default(0)
  lastAppliedAt   DateTime?
  priority        Int      @default(100) // lower = higher priority
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bankAccount     BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactions    BankTransaction[]

  @@index([tenantId])
  @@index([bankAccountId, isActive, priority])
}

/// A point-in-time reconciliation: ties cleared transactions to a statement period.
model ReconciliationSession {
  id              String   @id @default(cuid())
  tenantId        String
  bankAccountId   String
  statementStartDate DateTime
  statementEndDate   DateTime
  statementStartBalanceCents BigInt
  statementEndBalanceCents   BigInt
  // Sum of cleared txns at completion — should reconcile end-start balance
  clearedTotalCents BigInt? @default(0)
  status          ReconStatus @default(IN_PROGRESS)
  completedAt     DateTime?
  completedByUserId String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bankAccount     BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactions    BankTransaction[]

  @@index([tenantId])
  @@index([bankAccountId, status])
}

enum ReconStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// =============================================================================
// SIGNUP / CHECKOUT — pre-payment slug claim
// =============================================================================
// When a prospect picks a slug + tier, we reserve the slug here, create a Stripe
// checkout session, then provision the real Tenant on checkout.session.completed.
// =============================================================================
model PendingTenant {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  businessName          String
  legalName             String?
  email                 String
  tier                  TenantTier
  stripeCheckoutId      String?  @unique
  stripeCustomerId      String?
  status                PendingStatus @default(PENDING)
  provisionedTenantId   String?  @unique
  expiresAt             DateTime // slug released if no payment by this time
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status])
  @@index([expiresAt])
}

enum PendingStatus {
  PENDING       // checkout session created, awaiting payment
  COMPLETED     // tenant provisioned
  EXPIRED       // session expired without payment
  ABANDONED     // user manually closed
}

// =============================================================================
// MODULE STUBS — to be expanded in later cycles
// =============================================================================
// Cycle 4: ApprovalWorkflow, W9

/// Per-entity bill approval threshold. If a bill's totalCents (or baseTotalCents for FX) exceeds threshold,
/// it cannot be posted directly — it goes to PENDING_APPROVAL and must be approved by an OWNER/ADMIN.
model ApprovalRule {
  id              String   @id @default(cuid())
  tenantId        String
  entityId        String   @unique // one rule per entity for now
  // If totalCents > thresholdCents, bill requires approval. 0 = approve everything.
  thresholdCents  BigInt   @default(0)
  // If false, the rule is paused (everything posts directly).
  isEnabled       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Audit trail for bill approvals/rejections.
model BillApproval {
  id          String   @id @default(cuid())
  tenantId    String
  billId      String
  // Snapshot of submitter / approver Clerk IDs for the audit trail.
  submittedById String
  decidedById String?
  decision    String?  // "APPROVED" | "REJECTED" | null while pending
  note        String?
  submittedAt DateTime @default(now())
  decidedAt   DateTime?

  bill        Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([billId])
}
// Cycle 5: Employee, PayRun, Paystub, TaxFiling, TimeEntry
// Cycle 5/6: Embedding, AiQuery, AnomalyDetection, ClosingAssistant
// =============================================================================
// RECURRING INVOICES — auto-generate invoices on a schedule (Cycle 3 W9)
// =============================================================================
model RecurringInvoice {
  id              String                  @id @default(cuid())
  tenantId        String
  entityId        String
  customerId      String
  name            String                  // e.g. "Monthly Retainer — Acme Corp"
  // Schedule definition
  frequency       RecurringFrequency      @default(MONTHLY)
  intervalCount   Int                     @default(1) // every N units (e.g. every 2 weeks)
  dayOfMonth      Int?                    // 1-28 for MONTHLY (28 max to avoid Feb edge)
  startDate       DateTime
  endDate         DateTime?               // null = no end
  // Template details for generated invoices
  termsDays       Int                     @default(30)
  currency        String                  @default("USD")
  memo            String?
  // State
  status          RecurringStatus         @default(ACTIVE)
  nextRunDate     DateTime                // when to generate the next invoice
  lastRunDate     DateTime?
  runsCompleted   Int                     @default(0)
  maxRuns         Int?                    // null = no cap
  // Audit
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  entity   Entity                       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  customer Customer                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines    RecurringInvoiceLine[]
  runs     RecurringInvoiceRun[]

  @@index([tenantId])
  @@index([entityId])
  @@index([status, nextRunDate])
}

model RecurringInvoiceLine {
  id                   String   @id @default(cuid())
  tenantId             String
  recurringInvoiceId   String
  accountId            String
  description          String
  quantityMilli        BigInt   @default(1000)
  unitPriceCents       BigInt   @default(0)
  lineNumber           Int
  createdAt            DateTime @default(now())

  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  account          Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([recurringInvoiceId])
}

model RecurringInvoiceRun {
  id                   String   @id @default(cuid())
  tenantId             String
  recurringInvoiceId   String
  generatedInvoiceId   String?  @unique // null if generation failed
  scheduledFor         DateTime
  ranAt                DateTime @default(now())
  status               RecurringRunStatus @default(SUCCESS)
  errorMessage         String?

  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  generatedInvoice Invoice?         @relation(fields: [generatedInvoiceId], references: [id], onDelete: SetNull)

  @@index([recurringInvoiceId])
  @@index([tenantId])
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  COMPLETED // hit maxRuns or endDate
  CANCELED
}

enum RecurringRunStatus {
  SUCCESS
  FAILED
  SKIPPED
}

// =============================================================================
// RECURRING BILLS — auto-generate vendor bills on a schedule (Cycle 3 W9 part 2)
// =============================================================================
model RecurringBill {
  id              String                  @id @default(cuid())
  tenantId        String
  entityId        String
  vendorId        String
  name            String
  frequency       RecurringFrequency      @default(MONTHLY)
  intervalCount   Int                     @default(1)
  dayOfMonth      Int?
  startDate       DateTime
  endDate         DateTime?
  termsDays       Int                     @default(30)
  currency        String                  @default("USD")
  memo            String?
  status          RecurringStatus         @default(ACTIVE)
  nextRunDate     DateTime
  lastRunDate     DateTime?
  runsCompleted   Int                     @default(0)
  maxRuns         Int?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  entity Entity                 @relation(fields: [entityId], references: [id], onDelete: Cascade)
  vendor Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines  RecurringBillLine[]
  runs   RecurringBillRun[]

  @@index([tenantId])
  @@index([entityId])
  @@index([status, nextRunDate])
}

model RecurringBillLine {
  id                String   @id @default(cuid())
  tenantId          String
  recurringBillId   String
  accountId         String
  description       String
  quantityMilli     BigInt   @default(1000)
  unitPriceCents    BigInt   @default(0)
  lineNumber        Int
  createdAt         DateTime @default(now())

  recurringBill RecurringBill @relation(fields: [recurringBillId], references: [id], onDelete: Cascade)
  account       Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([recurringBillId])
}

model RecurringBillRun {
  id                 String   @id @default(cuid())
  tenantId           String
  recurringBillId    String
  generatedBillId    String?  @unique
  scheduledFor       DateTime
  ranAt              DateTime @default(now())
  status             RecurringRunStatus @default(SUCCESS)
  errorMessage       String?

  recurringBill RecurringBill @relation(fields: [recurringBillId], references: [id], onDelete: Cascade)
  generatedBill Bill?         @relation(fields: [generatedBillId], references: [id], onDelete: SetNull)

  @@index([recurringBillId])
  @@index([tenantId])
}

// =============================================================================
// BUDGETS — annual budgets per account, used for Budget vs Actual report
// =============================================================================
model Budget {
  id          String       @id @default(cuid())
  tenantId    String
  entityId    String
  name        String       // e.g. "FY2026 Operating Budget"
  fiscalYear  Int          // e.g. 2026
  currency    String       @default("USD")
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  entity Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  lines  BudgetLine[]

  @@unique([entityId, fiscalYear, name])
  @@index([tenantId])
  @@index([entityId, isActive])
}

model BudgetLine {
  id          String   @id @default(cuid())
  tenantId    String
  budgetId    String
  accountId   String
  // Monthly amounts in cents (positive = expected debit for expenses, credit for revenue)
  jan         BigInt   @default(0)
  feb         BigInt   @default(0)
  mar         BigInt   @default(0)
  apr         BigInt   @default(0)
  may         BigInt   @default(0)
  jun         BigInt   @default(0)
  jul         BigInt   @default(0)
  aug         BigInt   @default(0)
  sep         BigInt   @default(0)
  oct         BigInt   @default(0)
  nov         BigInt   @default(0)
  dec         BigInt   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  budget  Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([budgetId, accountId])
  @@index([tenantId])
  @@index([accountId])
}

// =============================================================================
// CLIENT PORTAL
// =============================================================================

/// External (client) user who logs into the firm's portal to upload docs and sign letters.
model ClientPortalUser {
  id          String   @id @default(cuid())
  tenantId    String
  entityId    String
  name        String
  email       String
  isActive    Boolean  @default(true)
  invitedAt   DateTime @default(now())
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions    PortalSession[]
  uploads     PortalUpload[]

  @@unique([tenantId, entityId, email])
  @@index([tenantId, isActive])
  @@index([entityId])
}

/// Magic-link session token for portal users.
model PortalSession {
  id             String           @id @default(cuid())
  tenantId       String
  portalUserId   String
  token          String           @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime         @default(now())

  portalUser     ClientPortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([portalUserId])
}

/// A request from the firm asking the client to provide documents/info.
model PortalDocumentRequest {
  id            String                @id @default(cuid())
  tenantId      String
  entityId      String
  engagementId  String?
  title         String                // e.g. "2025 Tax Documents"
  description   String?
  dueDate       DateTime?
  status        DocumentRequestStatus @default(OPEN)
  createdByUserId String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  completedAt   DateTime?

  items         PortalRequestItem[]

  @@index([tenantId, status])
  @@index([entityId, status])
  @@index([engagementId])
}

/// A single line item the client needs to provide.
model PortalRequestItem {
  id          String                @id @default(cuid())
  tenantId    String
  requestId   String
  label       String                // e.g. "W-2 from primary employer"
  notes       String?
  status      RequestItemStatus     @default(NEEDED)
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  request     PortalDocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploads     PortalUpload[]

  @@index([tenantId, status])
  @@index([requestId])
}

/// A file uploaded by the client (via URL for MVP — Blob upload comes later).
model PortalUpload {
  id            String              @id @default(cuid())
  tenantId      String
  entityId      String
  requestItemId String?
  portalUserId  String?
  fileName      String
  fileUrl       String              // Blob URL or external URL
  fileSizeBytes Int?
  contentType   String?
  note          String?
  createdAt     DateTime            @default(now())

  requestItem   PortalRequestItem?  @relation(fields: [requestItemId], references: [id], onDelete: SetNull)
  portalUser    ClientPortalUser?   @relation(fields: [portalUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityId])
  @@index([requestItemId])
}

enum DocumentRequestStatus {
  OPEN
  PARTIAL
  COMPLETE
  CANCELLED
}

enum RequestItemStatus {
  NEEDED
  RECEIVED
  WAIVED
}

// =============================================================================
// CRM (Leads & Deals)
// =============================================================================

/// Inbound prospect — pre-qualification.
model Lead {
  id           String       @id @default(cuid())
  tenantId     String
  name         String
  companyName  String?
  email        String?
  phone        String?
  source       LeadSource   @default(WEBSITE)
  status       LeadStatus   @default(NEW)
  ownerUserId  String?      // assigned firm user
  notes        String?
  convertedDealId  String?      @unique
  convertedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  activities   CrmActivity[]
  convertedDeal Deal?       @relation("LeadToDeal", fields: [convertedDealId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, ownerUserId])
}

/// Qualified opportunity moving through pipeline stages.
model Deal {
  id              String        @id @default(cuid())
  tenantId        String
  pipelineId      String
  stageId         String
  name            String
  entityId        String?       // becomes a client (entity) once won
  ownerUserId     String?
  amountCents     BigInt        @default(0)  // expected value in firm currency
  probabilityPct  Int           @default(50) // 0-100
  closeDate       DateTime?
  status          DealStatus    @default(OPEN)
  wonAt           DateTime?
  lostAt          DateTime?
  lostReason      String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  pipeline        Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage           DealStage     @relation(fields: [stageId], references: [id], onDelete: Restrict)
  activities      CrmActivity[]
  leadOrigin      Lead?         @relation("LeadToDeal")

  @@index([tenantId, status])
  @@index([tenantId, pipelineId, stageId])
  @@index([tenantId, ownerUserId])
}

model Pipeline {
  id        String       @id @default(cuid())
  tenantId  String
  name      String       // e.g. "New Client Sales"
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  stages    DealStage[]
  deals     Deal[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model DealStage {
  id          String      @id @default(cuid())
  tenantId    String
  pipelineId  String
  name        String      // "Qualified", "Proposal Sent", "Closed Won"
  sortOrder   Int         @default(0)
  isWon       Boolean     @default(false)
  isLost      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  pipeline    Pipeline    @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       Deal[]

  @@index([tenantId, pipelineId, sortOrder])
}

/// Notes, calls, emails, meetings logged against a Lead or Deal.
model CrmActivity {
  id          String         @id @default(cuid())
  tenantId    String
  leadId      String?
  dealId      String?
  type        ActivityType   @default(NOTE)
  subject     String
  body        String?
  occurredAt  DateTime       @default(now())
  createdByUserId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lead        Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal        Deal?          @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
  @@index([leadId])
  @@index([dealId])
}

enum LeadSource {
  WEBSITE
  REFERRAL
  COLD_OUTBOUND
  EVENT
  ADVERTISING
  PARTNER
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
}

// =============================================================================
// TIME TRACKING
// =============================================================================

/// Hourly billing rate, optionally scoped to user, engagement, or both.
/// Resolution order at time of entry: user+engagement > user > engagement > tenant default.
model BillingRate {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String?  // null = applies to all users
  engagementId  String?  // null = applies to all engagements
  rateCents     BigInt   // hourly rate in cents
  currency      String   @default("USD")
  isDefault     Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  engagement    Engagement? @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, engagementId])
}

/// Billable time entry on a practice-management engagement.
/// Distinct from the payroll TimeEntry above (which tracks employee hours).
model PracticeTimeEntry {
  id              String        @id @default(cuid())
  tenantId        String
  engagementId    String
  userId          String        // who logged the time
  description     String
  startedAt       DateTime      // when work began
  endedAt         DateTime?     // null = timer running
  durationMinutes Int           @default(0) // computed at stop; manual entries set directly
  rateCents       BigInt        @default(0) // snapshot of resolved rate at log time
  billableMinutes Int           @default(0) // may differ from durationMinutes (rounded/adjusted)
  isBillable      Boolean       @default(true)
  status          PracticeTimeStatus @default(LOGGED)
  invoiceId       String?       // set when included in an invoice
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  engagement      Engagement    @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([tenantId, startedAt])
  @@index([tenantId, userId])
  @@index([engagementId])
  @@index([tenantId, status])
}

enum PracticeTimeStatus {
  RUNNING    // timer active
  LOGGED     // stopped, awaiting approval
  APPROVED   // reviewed and ready to bill
  BILLED     // attached to an invoice
  WRITTEN_OFF // non-billable adjustment
}

// =============================================================================
// RECURRING ENGAGEMENTS — templates that generate Engagements on a schedule
// =============================================================================

model RecurringEngagement {
  id              String              @id @default(cuid())
  tenantId        String
  entityId        String              // client business
  name            String              // e.g. "Monthly Bookkeeping"
  type            EngagementType      @default(BOOKKEEPING)
  // Schedule
  frequency       RecurringFrequency  @default(MONTHLY)
  intervalCount   Int                 @default(1)
  dayOfMonth      Int?                // 1-28 for MONTHLY
  startDate       DateTime
  endDate         DateTime?           // null = no end
  // Template details copied to each generated engagement
  notes           String?
  // Default tasks (newline-separated). Materialized as Task rows on each run.
  defaultTaskTitles String?
  // State
  status          RecurringStatus     @default(ACTIVE)
  nextRunDate     DateTime
  lastRunDate     DateTime?
  runsCompleted   Int                 @default(0)
  maxRuns         Int?                // null = no cap
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  entity          Entity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  runs            RecurringEngagementRun[]

  @@index([tenantId])
  @@index([entityId])
  @@index([status, nextRunDate])
}

model RecurringEngagementRun {
  id                       String   @id @default(cuid())
  tenantId                 String
  recurringEngagementId    String
  generatedEngagementId    String?  // set when run succeeds
  runAt                    DateTime @default(now())
  status                   RecurringRunStatus
  errorMessage             String?

  recurringEngagement      RecurringEngagement @relation(fields: [recurringEngagementId], references: [id], onDelete: Cascade)

  @@index([recurringEngagementId])
  @@index([tenantId, runAt])
}

// =============================================================================
// TAX FILING TRACKER — calendar of tax filings (941/940/1099/sales tax/etc.)
// =============================================================================

enum TaxFilingType {
  FORM_941
  FORM_940
  FORM_W2
  FORM_1099_NEC
  FORM_1099_MISC
  SALES_TAX
  STATE_INCOME
  FEDERAL_INCOME
  STATE_PAYROLL
  PROPERTY_TAX
  EXCISE
  OTHER
}

enum TaxFilingStatus {
  UPCOMING
  IN_PROGRESS
  FILED
  LATE
  EXTENDED
  N_A
}

model TaxFiling {
  id           String          @id @default(cuid())
  tenantId     String
  entityId     String?         // which client business (firm-side)
  filingType   TaxFilingType
  jurisdiction String?         // e.g., "IRS", "CA-FTB", "CA-CDTFA"
  periodLabel  String          // e.g., "Q1 2026", "FY 2025"
  dueDate      DateTime
  filedAt      DateTime?
  amountCents  BigInt?         // tax due/paid in cents
  confirmationNo String?
  notes        String?
  status       TaxFilingStatus @default(UPCOMING)
  assigneeUserId String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([tenantId, dueDate])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, entityId, dueDate])
  @@index([tenantId, filingType])
}

// =============================================================================
// CUSTOMER COMMUNICATIONS — log of emails/statements/invoices sent
// =============================================================================

enum CommChannel {
  EMAIL
  SMS
  PORTAL
  PHONE
  MEETING
  OTHER
}

enum CommDirection {
  OUTBOUND
  INBOUND
}

model CustomerCommunication {
  id          String        @id @default(cuid())
  tenantId    String
  customerId  String?
  entityId    String?     // if not customer-bound, may be entity-bound
  channel     CommChannel
  direction   CommDirection @default(OUTBOUND)
  subject     String
  body        String?
  recipient   String?     // e.g., email address or phone number
  // Optional cross-ref to documents that triggered this comm
  invoiceId   String?
  statementBatchId String?
  letterId    String?
  sentByUserId String?
  sentAt      DateTime      @default(now())
  createdAt   DateTime      @default(now())

  @@index([tenantId, sentAt])
  @@index([tenantId, customerId, sentAt])
  @@index([tenantId, entityId, sentAt])
}

// =============================================================================
// DOCUMENT VAULT — general-purpose docs attached to entity/customer/vendor
// =============================================================================

enum VaultDocCategory {
  CONTRACT
  TAX
  FINANCIAL
  LEGAL
  HR
  RECEIPT
  OTHER
}

model VaultDocument {
  id          String   @id @default(cuid())
  tenantId    String
  entityId    String?     // firm-side: which client business
  customerId  String?     // optional: tie to a specific customer
  vendorId    String?     // optional: tie to a specific vendor
  title       String
  url         String      // external link (Drive, Dropbox, Box) OR blob URL
  category    VaultDocCategory @default(OTHER)
  description String?
  tags        String?     // comma-separated for now
  expiresAt   DateTime?   // for contracts, licenses, etc.
  uploadedByUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([tenantId, entityId])
  @@index([tenantId, customerId])
  @@index([tenantId, vendorId])
  @@index([tenantId, category])
  @@index([tenantId, expiresAt])
}

// =============================================================================
// WORKFLOW AUTOMATION — trigger/action rules
// =============================================================================

enum WorkflowTrigger {
  INVOICE_CREATED
  INVOICE_SENT
  INVOICE_PAID
  INVOICE_OVERDUE
  BILL_CREATED
  BILL_PAID
  BILL_OVERDUE
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  DEAL_CREATED
  DEAL_STAGE_CHANGED
  DEAL_WON
  DEAL_LOST
  TASK_COMPLETED
  ENGAGEMENT_LETTER_SIGNED
  PORTAL_DOCUMENT_UPLOADED
  CUSTOMER_CREATED
}

enum WorkflowActionType {
  CREATE_TASK
  LOG_ACTIVITY
  SEND_INTERNAL_NOTE
  CREATE_ENGAGEMENT
  UPDATE_DEAL_STAGE
}

enum WorkflowRunStatus {
  SUCCEEDED
  FAILED
  SKIPPED
}

model WorkflowRule {
  id          String          @id @default(cuid())
  tenantId    String
  name        String
  description String?
  trigger     WorkflowTrigger
  isActive    Boolean         @default(true)
  // JSON blob describing the action(s). Schema validated in code.
  // Examples:
  //  { type: "CREATE_TASK", title: "Follow up", priority: "MEDIUM", dueInDays: 3 }
  //  { type: "LOG_ACTIVITY", activityType: "NOTE", subject: "Auto: invoice paid" }
  actionType  WorkflowActionType
  actionConfig Json
  runCount    Int             @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  runs        WorkflowRun[]

  @@index([tenantId, trigger, isActive])
}

model WorkflowRun {
  id        String            @id @default(cuid())
  tenantId  String
  ruleId    String
  trigger   WorkflowTrigger
  // What entity fired the trigger (e.g., invoiceId, leadId)
  subjectType String
  subjectId   String
  status    WorkflowRunStatus
  message   String?
  runAt     DateTime          @default(now())

  rule      WorkflowRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([tenantId, runAt])
  @@index([ruleId, runAt])
}

