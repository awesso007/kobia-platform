// =============================================================================
// KOBIA.AI — Prisma Schema
// =============================================================================
// Multi-tenant database schema.
// Every business table includes `tenantId` for row-level data isolation (Lock EEEE).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// CORE: Tenant model — the "T" in multi-tenant
// -----------------------------------------------------------------------------
model Tenant {
  id              String   @id @default(cuid())
  slug            String   @unique // subdomain: {slug}.kobia.ai
  name            String
  legalName       String?
  ein             String?
  // Billing
  tier            TenantTier @default(FREE)
  stripeCustomerId String?  @unique
  // Branding (Lock EEEE — tenant-controlled UI)
  logoUrl         String?
  primaryColor    String?  @default("#0F172A")
  secondaryColor  String?  @default("#3B82F6")
  hideKobiaBrand  Boolean  @default(false) // forced true on tier > ENTRY (Lock EEEE)
  customDomain    String?  @unique
  // Status
  isActive        Boolean  @default(true)
  suspendedAt     DateTime?
  suspendReason   String?
  // Metadata
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Relations
  memberships     Membership[]
  apiKeys         ApiKey[]
  auditLogs       AuditLog[]
  subscription    Subscription?
  entities        Entity[]

  @@index([slug])
  @@index([tier])
}

enum TenantTier {
  FREE         // KOBIA brand shown ("Powered by KOBIA")
  ENTRY        // KOBIA brand shown
  SOLO         // KOBIA brand hidden — $149/mo
  FIRM         // KOBIA brand hidden — $399/mo
  FIRM_PLUS    // KOBIA brand hidden — $899/mo
  ENTERPRISE   // KOBIA brand hidden — custom pricing
  INTERNAL     // FIG and other KOBIA-owned tenants — free
}

// -----------------------------------------------------------------------------
// USER: One identity, can belong to multiple tenants
// -----------------------------------------------------------------------------
model User {
  id            String   @id @default(cuid())
  clerkUserId   String   @unique // Source of truth is Clerk
  email         String   @unique
  firstName     String?
  lastName      String?
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // Relations
  memberships   Membership[]
  auditLogs     AuditLog[]
}

// -----------------------------------------------------------------------------
// MEMBERSHIP: User <-> Tenant join with role (Lock HHH role-aware UI)
// -----------------------------------------------------------------------------
model Membership {
  id          String   @id @default(cuid())
  userId      String
  tenantId    String
  role        Role
  // Tenant-specific user details
  title       String?
  isActive    Boolean  @default(true)
  invitedAt   DateTime @default(now())
  acceptedAt  DateTime?
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

enum Role {
  OWNER         // Tenant owner — full control including billing
  ADMIN         // Admin — manages users, settings, all modules
  ACCOUNTANT    // Accountant role — full access to books/payroll/invoicing/AP
  STAFF         // Staff role — limited access
  CLIENT        // Tenant's client — limited access to their own data only (portal)
  VIEWER        // Read-only across modules
}

// -----------------------------------------------------------------------------
// API KEYS: For tenant integrations (Cycle 4+)
// -----------------------------------------------------------------------------
model ApiKey {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  keyHash     String   @unique // store hash, not raw key
  prefix      String   // first 8 chars shown in UI
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([keyHash])
}

// -----------------------------------------------------------------------------
// AUDIT LOG: Every action gets logged (SOC 2 prep)
// -----------------------------------------------------------------------------
model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String?
  action      String   // e.g. "tenant.created", "user.invited", "invoice.sent"
  entityType  String?  // e.g. "Invoice", "Bill"
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([action])
}

// -----------------------------------------------------------------------------
// SUBSCRIPTION: KOBIA's own billing (Cycle 1 Week 2 — Stripe)
// -----------------------------------------------------------------------------
model Subscription {
  id                    String    @id @default(cuid())
  tenantId              String    @unique
  stripeSubscriptionId  String    @unique
  stripePriceId         String
  status                SubStatus
  tier                  TenantTier
  // Trial
  trialStart            DateTime?
  trialEnd              DateTime?
  // Billing cycle
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean   @default(false)
  canceledAt            DateTime?
  // Metadata
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  // Relations
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([currentPeriodEnd])
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAUSED
}

// =============================================================================
// CYCLE 2 — BOOKKEEPING CORE (Chart of Accounts + General Ledger)
// =============================================================================
// Double-entry accounting. Every JournalEntry has 2+ JournalLines.
// Sum of debits = sum of credits per entry (enforced at app layer + DB constraint).
// =============================================================================

/// Entity = a single business's books inside a tenant. Firms manage many entities.
model Entity {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  legalName     String?
  ein           String?
  fiscalYearEnd String?  // "12-31", "06-30", etc.
  baseCurrency  String   @default("USD") // ISO 4217
  industry      String?  // for chart of accounts templates
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts        Account[]
  journalEntries  JournalEntry[]
  customers       Customer[]
  invoices        Invoice[]
  vendors         Vendor[]
  bills           Bill[]
  bankAccounts    BankAccount[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// Chart of Accounts node. Hierarchical via parentId.
model Account {
  id            String      @id @default(cuid())
  tenantId      String      // denormalized for query speed + Lock EEEE isolation
  entityId      String
  code          String      // e.g., "1000", "1010", "4000"
  name          String      // e.g., "Cash and equivalents"
  type          AccountType
  subtype       String?     // e.g., "Bank", "Accounts Receivable", "Cost of Goods Sold"
  parentId      String?
  description   String?
  isActive      Boolean     @default(true)
  isSystem      Boolean     @default(false) // protected (e.g., "Retained Earnings")
  // Cached balance updated on each journal post (denormalized for speed)
  balanceCents  BigInt      @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  entity            Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  parent            Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children          Account[]     @relation("AccountHierarchy")
  journalLines      JournalLine[]
  invoiceLines      InvoiceLine[]
  invoicePayments   InvoicePayment[] @relation("InvoicePaymentCashAccount")
  billLines         BillLine[]
  billPayments      BillPayment[]    @relation("BillPaymentCashAccount")
  bankAccounts      BankAccount[]

  @@unique([entityId, code])
  @@index([tenantId])
  @@index([entityId, type])
  @@index([parentId])
}

/// Standard accounting account categories. Drives reporting + normal balance side.
enum AccountType {
  ASSET         // Debit normal balance
  LIABILITY     // Credit normal balance
  EQUITY        // Credit normal balance
  REVENUE       // Credit normal balance
  EXPENSE       // Debit normal balance
  COGS          // Debit normal balance (Cost of Goods Sold subtype of Expense, broken out for P&L)
  OTHER_INCOME  // Credit normal balance
  OTHER_EXPENSE // Debit normal balance
}

/// A single journal entry. Header for 2+ JournalLines.
model JournalEntry {
  id            String       @id @default(cuid())
  tenantId      String
  entityId      String
  entryNumber   Int          // sequential per entity, set on post
  entryDate     DateTime     // accounting date (may differ from createdAt)
  description   String?
  memo          String?
  source        EntrySource  @default(MANUAL)
  sourceRefId   String?      // e.g., "bill_xxx", "invoice_xxx", "bankTxn_xxx"
  status        EntryStatus  @default(DRAFT)
  postedAt      DateTime?
  postedByUserId String?
  reversedById  String?      @unique // points to the reversing JE if this was reversed
  reversalOfId  String?      @unique // points to the original JE if this IS a reversal
  // Period lock (Lock from year-end close workflow)
  periodLocked  Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  entity        Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  lines         JournalLine[]
  reversedBy    JournalEntry? @relation("JournalReversal", fields: [reversedById], references: [id])
  reversalOf    JournalEntry? @relation("JournalReversal")

  @@unique([entityId, entryNumber])
  @@index([tenantId])
  @@index([entityId, entryDate])
  @@index([entityId, status])
  @@index([source, sourceRefId])
}

enum EntrySource {
  MANUAL          // accountant typed it
  BANK_FEED       // from Plaid/Finicity import
  INVOICE         // generated by an AR invoice
  BILL            // generated by an AP bill
  PAYMENT         // payment received or sent
  PAYROLL         // generated by a pay run
  ADJUSTMENT      // closing/adjusting entry
  OPENING_BALANCE // initial balances on entity creation
  AI_SUGGESTED    // generated by AI, awaiting approval
  IMPORT          // CSV/QBO migration
}

enum EntryStatus {
  DRAFT     // editable
  POSTED    // committed to ledger, balances updated
  REVERSED  // superseded by a reversing entry
  VOID      // canceled before post (DRAFT only)
}

/// One side of a journal entry. Debit OR credit, never both.
model JournalLine {
  id            String   @id @default(cuid())
  tenantId      String
  journalEntryId String
  accountId     String
  // Use BigInt cents to avoid floating-point error
  debitCents    BigInt   @default(0)
  creditCents   BigInt   @default(0)
  memo          String?
  // Dimensional tagging (Lock B6 — class/location/department)
  classTag      String?
  locationTag   String?
  departmentTag String?
  // For multi-entity / intercompany (future)
  contactRefType String? // "Customer", "Vendor", "Employee"
  contactRefId   String?
  lineNumber    Int      // ordering within the entry
  createdAt     DateTime @default(now())

  journalEntry  JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([journalEntryId])
  @@index([accountId])
  @@index([classTag])
  @@index([locationTag])
}

// =============================================================================
// ACCOUNTS RECEIVABLE — Cycle 3 (Customer, Invoice, InvoiceLine, InvoicePayment)
// =============================================================================

enum InvoiceStatus {
  DRAFT     // not posted to ledger, editable
  OPEN      // posted, balance > 0
  PARTIAL   // posted, partially paid
  PAID      // fully paid
  VOID      // cancelled (reverses original JE)
}

/// AR customer record — scoped to a single entity within a tenant.
model Customer {
  id            String   @id @default(cuid())
  tenantId      String
  entityId      String
  name          String
  email         String?
  phone         String?
  // Default net-terms in days (15, 30, 60). Used to compute dueDate when not specified.
  defaultTermsDays Int   @default(30)
  billingAddress String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entity   Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@unique([entityId, name])
  @@index([tenantId])
  @@index([entityId, isActive])
}

/// Customer invoice. Posts to ledger when status moves DRAFT -> OPEN.
model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  entityId       String
  customerId     String
  invoiceNumber  Int           // sequential per entity, set when posted
  issueDate      DateTime
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  // Money columns (cents, BigInt)
  subtotalCents  BigInt        @default(0)
  taxCents       BigInt        @default(0)
  totalCents     BigInt        @default(0)
  paidCents      BigInt        @default(0)
  // Convenience: totalCents - paidCents, recomputed on payment
  balanceCents   BigInt        @default(0)
  memo           String?
  // Link to the posting JE (created when invoice goes OPEN)
  postingJournalEntryId String? @unique
  postedAt       DateTime?
  voidedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  entity   Entity            @relation(fields: [entityId], references: [id], onDelete: Cascade)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines    InvoiceLine[]
  payments InvoicePayment[]

  @@unique([entityId, invoiceNumber])
  @@index([tenantId])
  @@index([entityId, status])
  @@index([customerId, status])
  @@index([dueDate])
}

/// One line on an invoice. Debits AR / credits a revenue account when posted.
model InvoiceLine {
  id            String   @id @default(cuid())
  tenantId      String
  invoiceId     String
  // Revenue account this line credits when posted
  accountId     String
  description   String
  // Quantity stored as integer thousandths (3 decimal places) to support fractional units
  quantityMilli BigInt   @default(1000)
  unitPriceCents BigInt  @default(0)
  amountCents   BigInt   @default(0)   // quantityMilli/1000 * unitPriceCents, rounded
  lineNumber    Int
  createdAt     DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([accountId])
}

/// Customer payment applied to an invoice. Debits cash / credits AR when posted.
model InvoicePayment {
  id            String   @id @default(cuid())
  tenantId      String
  invoiceId     String
  paymentDate   DateTime
  amountCents   BigInt
  // Cash/bank account this payment debits
  cashAccountId String
  method        String?  // "check", "ach", "card", "cash"
  reference     String?  // check #, etc.
  // Link to the JE that recorded the payment
  journalEntryId String? @unique
  createdAt     DateTime @default(now())

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  cashAccount Account @relation("InvoicePaymentCashAccount", fields: [cashAccountId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([paymentDate])
}

// =============================================================================
// ACCOUNTS PAYABLE (AP) — Vendors, Bills, BillPayments
// Mirror of AR: bills credit AP (LIABILITY), payments debit AP / credit cash.
// =============================================================================

enum BillStatus {
  DRAFT     // not posted to ledger, editable
  OPEN      // posted, balance > 0
  PARTIAL   // posted, partially paid
  PAID      // fully paid
  VOID      // cancelled (reverses original JE)
}

/// AP vendor record — scoped to a single entity within a tenant.
model Vendor {
  id            String   @id @default(cuid())
  tenantId      String
  entityId      String
  name          String
  email         String?
  phone         String?
  // Default net-terms in days vendor extends to us.
  defaultTermsDays Int   @default(30)
  remitToAddress String?
  // For 1099 / W-9 tracking (Cycle 4 expansion)
  taxId         String?
  is1099Vendor  Boolean  @default(false)
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  bills  Bill[]

  @@unique([entityId, name])
  @@index([tenantId])
  @@index([entityId, isActive])
}

/// Vendor bill. Posts to ledger when status moves DRAFT -> OPEN.
model Bill {
  id             String     @id @default(cuid())
  tenantId       String
  entityId       String
  vendorId       String
  // Vendor's own invoice/bill number (e.g., "INV-2026-001"). Optional, free text.
  vendorBillNumber String?
  // Sequential per entity, set when posted (internal AP doc number).
  billNumber     Int
  billDate       DateTime
  dueDate        DateTime
  status         BillStatus @default(DRAFT)
  subtotalCents  BigInt     @default(0)
  taxCents       BigInt     @default(0)
  totalCents     BigInt     @default(0)
  paidCents      BigInt     @default(0)
  balanceCents   BigInt     @default(0)
  memo           String?
  postingJournalEntryId String? @unique
  postedAt       DateTime?
  voidedAt       DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  entity   Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)
  vendor   Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines    BillLine[]
  payments BillPayment[]

  @@unique([entityId, billNumber])
  @@index([tenantId])
  @@index([entityId, status])
  @@index([entityId, billDate])
  @@index([vendorId])
}

/// Expense or asset line on a vendor bill. Debits the chosen account when posted.
model BillLine {
  id            String   @id @default(cuid())
  tenantId      String
  billId        String
  // Expense or asset account this line debits when posted
  accountId     String
  description   String
  // Quantity stored as integer thousandths (3 decimal places).
  quantityMilli BigInt   @default(1000)
  unitPriceCents BigInt  @default(0)
  amountCents   BigInt   @default(0)
  lineNumber    Int
  createdAt     DateTime @default(now())

  bill    Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([billId])
  @@index([accountId])
}

/// Payment made to a vendor. Credits cash / debits AP when posted.
model BillPayment {
  id            String   @id @default(cuid())
  tenantId      String
  billId        String
  paymentDate   DateTime
  amountCents   BigInt
  // Cash/bank account this payment credits
  cashAccountId String
  method        String?  // "check", "ach", "card", "cash", "wire"
  reference     String?  // check #, confirmation #, etc.
  // Link to the JE that recorded the payment
  journalEntryId String? @unique
  createdAt     DateTime @default(now())

  bill        Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  cashAccount Account @relation("BillPaymentCashAccount", fields: [cashAccountId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([billId])
  @@index([paymentDate])
}

// =============================================================================
// BANK RECONCILIATION — Cycle 3 W3
// =============================================================================

/// A real-world bank/credit-card account, linked to a GL cash/liability account.
/// One GL account can have at most one BankAccount.
model BankAccount {
  id              String   @id @default(cuid())
  tenantId        String
  entityId        String
  // The GL account this bank account posts to (must be ASSET for bank, LIABILITY for credit card)
  glAccountId     String   @unique
  name            String   // Display name e.g. "Chase Business Checking …4521"
  institution     String?  // "Chase", "Bank of America"
  accountLast4    String?  // "4521"
  accountType     BankAccountType @default(CHECKING)
  currency        String   @default("USD")
  // Optional opening balance snapshot for first reconciliation
  openingBalanceCents BigInt @default(0)
  openingBalanceDate  DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  entity        Entity                 @relation(fields: [entityId], references: [id], onDelete: Cascade)
  glAccount     Account                @relation(fields: [glAccountId], references: [id], onDelete: Restrict)
  transactions  BankTransaction[]
  rules         BankRule[]
  sessions      ReconciliationSession[]

  @@index([tenantId])
  @@index([entityId, isActive])
}

enum BankAccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  MONEY_MARKET
  LOAN
  OTHER
}

/// A single transaction line imported from a bank feed or CSV statement.
/// `amountCents` is signed: positive = money in (deposit), negative = money out (withdrawal).
model BankTransaction {
  id              String   @id @default(cuid())
  tenantId        String
  bankAccountId   String
  postedDate      DateTime
  description     String
  amountCents     BigInt   // signed; +inflow / -outflow
  balanceAfterCents BigInt? // optional, if statement provides running balance
  // Stable hash for dedup: SHA-1(postedDate|amount|description) — set on import
  dedupHash       String
  source          BankTxnSource @default(CSV_IMPORT)
  rawData         Json?    // original CSV row or feed payload
  status          BankTxnStatus @default(UNMATCHED)
  // When matched to an existing JE (e.g. invoice payment, bill payment, manual JE)
  matchedJournalEntryId String?
  matchedAt       DateTime?
  matchedByUserId String?
  // When categorized (creates a NEW JE) instead of matched
  categorizedJournalEntryId String?
  categorizedAt   DateTime?
  categorizedByUserId String?
  // Reconciliation session this txn was cleared in (set on session complete)
  reconciliationId String?
  clearedAt        DateTime?
  // Optional rule that auto-categorized this
  appliedRuleId   String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bankAccount     BankAccount            @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  reconciliation  ReconciliationSession? @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)
  appliedRule     BankRule?              @relation(fields: [appliedRuleId], references: [id], onDelete: SetNull)

  @@unique([bankAccountId, dedupHash])
  @@index([tenantId])
  @@index([bankAccountId, status])
  @@index([bankAccountId, postedDate])
  @@index([matchedJournalEntryId])
  @@index([categorizedJournalEntryId])
  @@index([reconciliationId])
}

enum BankTxnSource {
  CSV_IMPORT
  MANUAL
  PLAID         // future
  STRIPE_FEED   // future
}

enum BankTxnStatus {
  UNMATCHED   // imported, not yet matched or categorized
  MATCHED     // tied to an existing JE
  CATEGORIZED // a new JE was created from this txn
  CLEARED     // included in a completed reconciliation session
  IGNORED     // user marked as not-for-books (transfer between own accts, etc.)
}

/// User-defined or AI-suggested rule for auto-categorizing future bank txns.
/// Example: description contains "ADOBE" → debit 6600 Software & Subscriptions, credit this bank account.
model BankRule {
  id              String   @id @default(cuid())
  tenantId        String
  bankAccountId   String   // scope to a single bank account (null = entity-wide future)
  name            String
  // Match criteria — for MVP: simple substring match on description
  descriptionContains String
  // Optional: only apply if amount sign matches
  appliesToInflow  Boolean @default(true)
  appliesToOutflow Boolean @default(true)
  // Categorization target
  offsetAccountId String   // The account to debit (outflow) or credit (inflow) opposite of bank
  memoTemplate    String?  // Optional memo to set on created JE
  contactRefType  String?  // "Vendor", "Customer", etc.
  contactRefId    String?
  // Stats
  appliedCount    Int      @default(0)
  lastAppliedAt   DateTime?
  priority        Int      @default(100) // lower = higher priority
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bankAccount     BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactions    BankTransaction[]

  @@index([tenantId])
  @@index([bankAccountId, isActive, priority])
}

/// A point-in-time reconciliation: ties cleared transactions to a statement period.
model ReconciliationSession {
  id              String   @id @default(cuid())
  tenantId        String
  bankAccountId   String
  statementStartDate DateTime
  statementEndDate   DateTime
  statementStartBalanceCents BigInt
  statementEndBalanceCents   BigInt
  // Sum of cleared txns at completion — should reconcile end-start balance
  clearedTotalCents BigInt? @default(0)
  status          ReconStatus @default(IN_PROGRESS)
  completedAt     DateTime?
  completedByUserId String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bankAccount     BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactions    BankTransaction[]

  @@index([tenantId])
  @@index([bankAccountId, status])
}

enum ReconStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// =============================================================================
// SIGNUP / CHECKOUT — pre-payment slug claim
// =============================================================================
// When a prospect picks a slug + tier, we reserve the slug here, create a Stripe
// checkout session, then provision the real Tenant on checkout.session.completed.
// =============================================================================
model PendingTenant {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  businessName          String
  legalName             String?
  email                 String
  tier                  TenantTier
  stripeCheckoutId      String?  @unique
  stripeCustomerId      String?
  status                PendingStatus @default(PENDING)
  provisionedTenantId   String?  @unique
  expiresAt             DateTime // slug released if no payment by this time
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status])
  @@index([expiresAt])
}

enum PendingStatus {
  PENDING       // checkout session created, awaiting payment
  COMPLETED     // tenant provisioned
  EXPIRED       // session expired without payment
  ABANDONED     // user manually closed
}

