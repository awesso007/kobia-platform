# CHESS CORP 2: non-executable NAMES-ONLY configuration placeholder
# Round 24. NOT an alternate owner checklist. The sole action register:
# docs/CHESS_CORP_2_OWNER_SUPPLY_CHECKLIST.md
#
# This file is NOT automatically loaded as .env.local.
# Keep ALL secrets in a vault/protected GitHub environment; never commit values.
# Every release/automation feature is intentionally FALSE or commented.
# Never load these example flags into a live production deployment as approval.
#
# P0 fictional demo is a SEPARATE database and Clerk test instance, documented
# in README. Do NOT use a demo database to test real payments/tax/regulated work.

# Round 46 manual PROTECTED FICTIONAL browser E2E ONLY.
# Supply values as protected GitHub Environment 'chess-demo-e2e' secrets/vars,
# not an .env file committed to the repository and never in production.
# Workflow secret DATABASE_URL must target non-pooled Neon chess_demo ONLY,
# TLS sslmode=require; the existing CLERK_SECRET_KEY, and the separate
# GitHub secret CLERK_PUBLISHABLE_KEY, must both be development/test keys.
# GitHub vars (three DISTINCT verified test identities from that same Clerk app):
# CHESS_DEMO_OWNER_EMAIL=
# CHESS_DEMO_EMPLOYEE_EMAIL=
# CHESS_DEMO_CLIENT_EMAIL=
# CHESS_DEMO_E2E_BASE_URL=http://127.0.0.1:3000  # pinned local only
# CHESS_DEMO_MODE=true    # ONLY in isolated development browser workflow
# NEXT_PUBLIC_DEFAULT_TENANT=chess-demo  # ONLY protected test workflow
# The workflow requires manual confirm_isolated_demo=true; never auto-run.
# Normal CI tests syntax and disposable seeded PostgreSQL, not Clerk browsers.

# P1 tenant HTTPS app, separate runtime/migration PostgreSQL, Clerk TEST app
# DATABASE_URL=
# DIRECT_URL=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_APP_URL=
# NEXT_PUBLIC_ROOT_DOMAIN=
# NEXT_PUBLIC_DEFAULT_TENANT=
# CHESS_PUBLIC_ORIGIN=

# M3: verified client identity, signed consent, scoped storage and scanner
# CHESS_CONSENT_EVIDENCE_KEY=       # 32+ char unique high-entropy vault secret
CHESS_CLIENT_CONSENT_PORTAL_ENABLED=false
CHESS_CLIENT_PORTAL_POLICY_APPROVED=false
CHESS_CLIENT_PORTAL_IDENTITY_APPROVED=false
# KOBIA_S3_BUCKET=
# KOBIA_S3_REGION=
# KOBIA_S3_ACCESS_KEY_ID=
# KOBIA_S3_SECRET_ACCESS_KEY=
# KOBIA_S3_ENDPOINT=               # optional approved S3-compatible service
# KOBIA_LOCAL_DOWNLOAD_SIGNING_KEY= # 32+ random bytes; isolated dev/stage only
# LOCAL requires this server-only signing secret or download fails closed.
# Legacy helpdesk email-only portal is hard-disabled until one-time verified
# identity challenge code/provider review. No flag can reenable that old flow.
# CHESS_CLAMAV_HOST=              # private scanner endpoint
# CHESS_CLAMAV_PORT=3310
# CHESS_SCAN_WORKER_TOKEN=
# CHESS_DOCUMENT_SCAN_KEY=         # optional independently approved scanner HMAC
CHESS_SCAN_CALLBACK_ENABLED=false
CHESS_DOCUMENT_LIFECYCLE_ENABLED=false
CHESS_DOCUMENT_RETENTION_POLICY_APPROVED=false
# Round 39: independent document retention/hold review, exact S3 version deletion.
# No purge can run without all four flags, a distinct 32+ byte worker secret,
# approved immutable receipts, and a separate object-storage deletion policy.
CHESS_DOCUMENT_PURGE_EXECUTION_ENABLED=false
CHESS_DOCUMENT_PURGE_STORAGE_APPROVED=false
# CHESS_DOCUMENT_PURGE_WORKER_TOKEN=  # vault-only; 32+ characters, distinct from scanner token

# Round 47: legacy Vercel scheduler-only Bearer admission control.
# CRON_SECRET=                   # 32+ bytes fresh high-entropy secret, server-only.
# Must be supplied in protected Vercel staging/runtime environment; absence
# deliberately disables all 17 historical /api/cron routes with HTTP 503.
# Not a consent/financial approval and not used by CHESS private worker APIs.

# Round 48: machine mail relay and signed public email tracking.
# EMAIL_INBOUND_SECRET=              # independent 32+ byte relay secret (vault-only)
# EMAIL_INBOUND_DOMAIN=inbound.kobia.ai  # approved exact domain / active aliases
# KOBIA_TRACKING_SIGNING_KEY=        # independent 32+ byte HMAC key, vault-only
# Missing tracking key intentionally disables signed-click redirects and
# omission of open-pixel injection; old unsigned campaign links do not work.
# TWILIO_AUTH_TOKEN=                 # from protected certified Twilio sandbox
# Reconfigure provider webhooks with signed ?tenant=<slug> query selector.
# Historical Stripe billing and signup webhooks remain permanently quarantined
# at HTTP 503 pending a separately implemented, independently verified inbox.
# No feature switch in this file can reenable unsafe legacy Stripe callbacks.
# Public Forms 2.0 payment initiation is also 503 until a real receipt exists.

